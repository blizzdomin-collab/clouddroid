# Dodo Payments Configuration
# Get your API key from https://dodopayments.com/dashboard/developer/api-keys
DODO_PAYMENTS_API_KEY=your_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=your_webhook_secret_here

# Environment: test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=live_mode

# Return URL after successful checkout
DODO_PAYMENTS_RETURN_URL=https://clouddroid.eu/checkout/success

# Webhook endpoint (for Dodo Payments dashboard)
# https://clouddroid.eu/api/webhooks/dodopayments

# Mollie Configuration
# Get your API key from https://my.mollie.com/dashboard/developers/api-keys
MOLLIE_API_KEY=your_api_key_here
MOLLIE_WEBHOOK_KEY=your_webhook_secret_here

# Environment: test or live
MOLLIE_ENVIRONMENT=live

# Return URL after successful Mollie payment
MOLLIE_RETURN_URL=https://clouddroid.eu/checkout/success

# Webhook endpoint (for Mollie dashboard)
# https://clouddroid.eu/api/webhooks/mollie

# PayNow Configuration
# Get your API key from https://paynow.gg/dashboard
PAYNOW_API_KEY=your_api_key_here
PAYNOW_WEBHOOK_KEY=your_webhook_secret_here

# Environment: test or live
PAYNOW_ENVIRONMENT=live

# Return URL after successful PayNow payment
PAYNOW_RETURN_URL=https://clouddroid.eu/checkout/success

# Webhook endpoint (for PayNow dashboard)
# https://clouddroid.eu/api/webhooks/paynow

# EasyTransac Configuration
# Get your API key from https://www.easytransac.com/dashboard
EASYTRANSAC_API_KEY=your_api_key_here
EASYTRANSAC_WEBHOOK_KEY=your_webhook_secret_here

# Environment: test or live
EASYTRANSAC_ENVIRONMENT=live

# Return URL after successful EasyTransac payment
EASYTRANSAC_RETURN_URL=https://clouddroid.eu/checkout/success

# Cancel URL after EasyTransac payment cancellation
EASYTRANSAC_CANCEL_URL=https://clouddroid.eu/pricing

# Webhook endpoint (for EasyTransac dashboard)
# https://clouddroid.eu/api/webhooks/easytransac
