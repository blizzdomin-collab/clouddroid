---
import '../styles/global.css';
import { getUserByEmail } from '../lib/database';
import Announcements from '../components/Announcements.astro';
import Toast from '../components/Toast.astro';

interface Props {
  title?: string;
}

const {
  title = 'Dashboard - CloudDroid',
} = Astro.props;

const sessionCookie = Astro.cookies.get('session');
let isAuthenticated = false;
let mustChangePassword = false;
let currentUser: { email: string; name: string; role: string } | null = null;
let unreadAlerts = 0;
let announcements: any[] = [];

if (sessionCookie) {
  try {
    const session = JSON.parse(sessionCookie.value);
    if (session.authenticated === true && session.email) {
      const user = getUserByEmail(session.email);
      if (user) {
        isAuthenticated = true;
        mustChangePassword = session.must_change_password === true || user.must_change_password === true;
        currentUser = { email: user.email, name: user.name, role: user.role };
      }
    }
  } catch {
    isAuthenticated = false;
  }
}

if (isAuthenticated) {
  try {
    const alertsRes = await fetch(`${Astro.url.origin}/api/alerts?acknowledged=false&limit=1`, {
      headers: { Cookie: `session=${sessionCookie?.value}` },
    });
    if (alertsRes.ok) {
      const alertsData = await alertsRes.json();
      unreadAlerts = alertsData.summary?.unacknowledged || 0;
    }

    const announcementsRes = await fetch(`${Astro.url.origin}/api/announcements`, {
      headers: { Cookie: `session=${sessionCookie?.value}` },
    });
    if (announcementsRes.ok) {
      const announcementsData = await announcementsRes.json();
      announcements = announcementsData.announcements || [];
    }
  } catch {
    unreadAlerts = 0;
    announcements = [];
  }
}

if (!isAuthenticated) {
  return Astro.redirect('/login');
}

if (mustChangePassword && !Astro.url.pathname.startsWith('/change-password')) {
  return Astro.redirect('/change-password');
}

const navItems = [
  { href: '/dashboard', label: 'Overview', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/dashboard/instances', label: 'Instances', icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { href: '/dashboard/monitoring', label: 'Monitoring', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { href: '/dashboard/compliance', label: 'Compliance', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { href: '/dashboard/alerts', label: 'Alerts', icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9', badge: unreadAlerts },
  { href: '/dashboard/activity', label: 'Activity', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { href: '/dashboard/announcements', label: 'Announcements', icon: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z' },
  { href: '/dashboard/settings', label: 'Settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
  { href: '/dashboard/billing', label: 'Billing', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
];

const adminNavItems = [
  { href: '/dashboard/admin', label: 'Admin', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { href: '/dashboard/users', label: 'Users', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CloudDroid Dashboard" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="antialiased bg-navy text-slate">
    <div class="flex h-screen overflow-hidden">
      <!-- Mobile sidebar overlay -->
      <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden" onclick="document.getElementById('sidebar').classList.add('-translate-x-full');document.getElementById('sidebar-overlay').classList.add('hidden')"></div>

      <!-- Sidebar -->
      <aside id="sidebar" class="w-64 bg-navy text-white flex flex-col flex-shrink-0 fixed inset-y-0 left-0 z-50 transform -translate-x-full lg:translate-x-0 lg:static lg:z-auto transition-transform duration-300">
        <!-- Logo -->
        <div class="h-16 flex items-center px-6 border-b border-white/10">
          <a href="/" class="flex items-center gap-2.5">
            <div class="w-8 h-8 bg-accent rounded-lg flex items-center justify-center">
              <span class="text-white font-bold text-xs">CD</span>
            </div>
            <span class="font-semibold text-base tracking-tight">CloudDroid</span>
          </a>
        </div>

        <!-- User card -->
        {currentUser && (
          <div class="px-4 py-4">
            <div class="bg-white/[0.07] rounded-lg p-3">
              <div class="text-sm font-medium text-white truncate">{currentUser.name}</div>
              <div class="text-xs text-slate-400 truncate">{currentUser.email}</div>
              <div class="text-[10px] text-slate-500 uppercase tracking-wider mt-1 font-medium">{currentUser.role}</div>
            </div>
          </div>
        )}

        <!-- Navigation -->
        <nav class="flex-1 px-3 py-2 space-y-0.5 overflow-y-auto">
          {navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/dashboard' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 ${
                  isActive
                    ? 'bg-accent text-white shadow-lg shadow-accent/25'
                    : 'text-slate-400 hover:bg-white/[0.06] hover:text-white'
                }`}
              >
                <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
                </svg>
                <span>{item.label}</span>
                {item.badge && item.badge > 0 && (
                  <span class="ml-auto inline-flex items-center justify-center w-5 h-5 text-[10px] font-bold leading-none text-white bg-red-500 rounded-full">
                    {item.badge > 9 ? '9+' : item.badge}
                  </span>
                )}
              </a>
            );
          })}

          {currentUser?.role === 'admin' && (
            <>
              <div class="pt-4 pb-2 px-3">
                <span class="text-[10px] uppercase tracking-wider text-slate-600 font-semibold">Admin</span>
              </div>
              {adminNavItems.map((item) => {
                const isActive = currentPath === item.href;
                return (
                  <a
                    href={item.href}
                    class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 ${
                      isActive
                        ? 'bg-accent text-white shadow-lg shadow-accent/25'
                        : 'text-slate-400 hover:bg-white/[0.06] hover:text-white'
                    }`}
                  >
                    <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
                    </svg>
                    <span>{item.label}</span>
                  </a>
                );
              })}
            </>
          )}
        </nav>

        <!-- Bottom actions -->
        <div class="p-3 border-t border-white/10 space-y-0.5">
          <form action="/api/auth/logout" method="post" class="w-full">
            <button type="submit" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:bg-white/[0.06] hover:text-white transition-all duration-150">
              <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Sign Out
            </button>
          </form>
          <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:bg-white/[0.06] hover:text-white transition-all duration-150">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Site
          </a>
        </div>
      </aside>

      <!-- Main content -->
      <main class="flex-1 overflow-y-auto bg-navy min-h-screen">
        <!-- Mobile header -->
        <div class="lg:hidden flex items-center justify-between px-4 py-3 bg-navy-light border-b border-slate-700">
          <button id="open-sidebar" class="p-2 -ml-2 text-slate hover:text-slate-100">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
          <span class="font-semibold text-slate-100">CloudDroid</span>
          <div class="w-8"></div>
        </div>
        <Announcements announcements={announcements} />
        <div class="p-6 lg:p-8">
          <slot />
        </div>
      </main>
    </div>

    <!-- Toast container -->
    <div id="toast-container" class="toast-container"></div>

    <script>
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      const openBtn = document.getElementById('open-sidebar');

      openBtn?.addEventListener('click', () => {
        sidebar?.classList.remove('-translate-x-full');
        overlay?.classList.remove('hidden');
      });

      overlay?.addEventListener('click', () => {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
      });

      window.showToast = function(message, type = 'info') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.textContent = message;
        container.appendChild(toast);
        requestAnimationFrame(() => toast.classList.add('toast-enter'));
        setTimeout(() => {
          toast.classList.remove('toast-enter');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      };
    </script>
  </body>
</html>
