---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, any>;
}

const {
  title = 'CloudDroid - Enterprise-Grade Cloud Android Workspaces',
  description = 'Secure, high-performance virtual Android environments engineered for QA automation, app testing, and seamless remote productivity.',
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url.origin + Astro.url.pathname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.origin + Astro.url.pathname} />
    <meta property="og:image" content={Astro.url.origin + '/og-image.svg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="CloudDroid" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={Astro.url.origin + '/og-image.svg'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5PFFX5S7');</script>
    <!-- End Google Tag Manager -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'CloudDroid',
      url: Astro.url.origin,
      logo: `${Astro.url.origin}/favicon.svg`,
      description: description,
      telephone: '+420734210456',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Soukenická 877/9',
        addressLocality: 'Ostrava',
        postalCode: '702 00',
        addressCountry: 'CZ',
      },
      sameAs: [],
    })} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5PFFX5S7"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-navy focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      Skip to main content
    </a>
    <div id="rebrand-banner" class="bg-accent text-white text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-center gap-3 relative">
        <span class="inline-flex items-center gap-2 font-medium">
          <span class="inline-block w-2 h-2 bg-white rounded-full animate-pulse"></span>
          CloudDroid is becoming <strong class="font-semibold">Liberty Assurance</strong>
        </span>
        <span class="text-white/80">— same team, same business activity, expanding our platform. More updates coming soon.</span>
        <button
          type="button"
          id="rebrand-banner-close"
          aria-label="Dismiss announcement"
          class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white transition-colors p-1"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 bg-navy text-white p-4 shadow-lg transform translate-y-full transition-transform duration-300 z-50" role="dialog" aria-label="Cookie consent">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-slate-300">
          This site uses essential cookies to operate and Google AdSense for advertising. By clicking "Accept", you consent to advertising cookies. You can learn more in our <a href="/legal/privacy" class="underline text-white">Privacy Policy</a>.
        </p>
        <button id="cookie-accept" class="bg-white text-navy px-4 py-2 rounded-lg text-sm font-medium hover:bg-slate-100 transition-colors whitespace-nowrap">
          Accept
        </button>
      </div>
    </div>

    <noscript>
      <style>
        #cookie-banner { transform: translate-y(0) !important; }
      </style>
    </noscript>

    <script>
      (function() {
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('cookie-accept');
        if (!banner || !acceptBtn) return;

        function loadAdSense() {
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8441247317236603';
          script.crossOrigin = 'anonymous';
          document.head.appendChild(script);
        }

        if (localStorage.getItem('cookie-consent') === 'accepted') {
          banner.remove();
          loadAdSense();
          return;
        }

        requestAnimationFrame(() => {
          banner.classList.remove('translate-y-full');
        });

        acceptBtn.addEventListener('click', () => {
          localStorage.setItem('cookie-consent', 'accepted');
          banner.classList.add('translate-y-full');
          setTimeout(() => {
            banner.remove();
            loadAdSense();
          }, 300);
        });
      })();

      (function() {
        const banner = document.getElementById('rebrand-banner');
        const closeBtn = document.getElementById('rebrand-banner-close');
        if (!banner || !closeBtn) return;
        if (localStorage.getItem('rebrand-banner-dismissed') === '1') {
          banner.remove();
          return;
        }
        closeBtn.addEventListener('click', () => {
          localStorage.setItem('rebrand-banner-dismissed', '1');
          banner.remove();
        });
      })();
    </script>
  </body>
</html>
