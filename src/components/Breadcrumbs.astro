---
interface Props {
  items: { label: string; href?: string }[];
}

const { items = [] } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bg-slate-light border-b border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <ol class="flex items-center gap-2 text-sm text-slate">
      <li>
        <a href="/" class="hover:text-navy transition-colors">Home</a>
      </li>
      {items.map((item, index) => (
        <li class="flex items-center gap-2" key={index}>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          {item.href ? (
            <a href={item.href} class="hover:text-navy transition-colors">{item.label}</a>
          ) : (
            <span class="text-navy font-medium" aria-current="page">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
