---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const alertsRes = await fetch(`${Astro.url.origin}/api/alerts?limit=10&offset=0`);
const alertsData = await alertsRes.json();
const alerts = alertsData.alerts || [];
const alertsSummary = alertsData.summary || {};
const pagination = alertsData.pagination || {};
---

<DashboardLayout title="Alerts - CloudDroid">
  <div class="p-8">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-navy mb-2">Alerts</h1>
        <p class="text-slate">Live compliance and security monitoring</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        <span class="text-sm text-slate">Live</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-sm text-slate mb-1">Total Alerts</div>
        <div class="text-3xl font-bold text-navy">{alertsSummary.total || 0}</div>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-sm text-slate mb-1">Unacknowledged</div>
        <div class="text-3xl font-bold text-red-600">{alertsSummary.unacknowledged || 0}</div>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-sm text-slate mb-1">Critical</div>
        <div class="text-3xl font-bold text-red-600">{alertsSummary.critical || 0}</div>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-sm text-slate mb-1">Warnings</div>
        <div class="text-3xl font-bold text-yellow-600">{alertsSummary.warning || 0}</div>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-semibold text-navy">Active Alerts</h2>
      </div>
      <div class="p-4 border-b border-slate-200 bg-slate-50">
        <div class="flex flex-wrap items-center gap-3">
          <select id="filter-severity" class="text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white">
            <option value="">All Severities</option>
            <option value="critical">Critical</option>
            <option value="warning">Warning</option>
            <option value="info">Info</option>
          </select>
          <select id="filter-type" class="text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white">
            <option value="">All Types</option>
            <option value="cpu">CPU</option>
            <option value="network">Network</option>
            <option value="aup">AUP</option>
            <option value="security">Security</option>
            <option value="billing">Billing</option>
          </select>
          <select id="filter-acknowledged" class="text-sm border border-slate-200 rounded-lg px-3 py-2 bg-white">
            <option value="">All Status</option>
            <option value="false">Unacknowledged</option>
            <option value="true">Acknowledged</option>
          </select>
          <button id="apply-filters" class="text-sm bg-navy text-white px-4 py-2 rounded-lg font-medium hover:bg-navy-light transition-colors">Apply</button>
          <button id="clear-filters" class="text-sm text-slate hover:text-navy font-medium">Clear</button>
        </div>
      </div>
      <div id="alerts-list" class="divide-y divide-slate-200">
        {alerts.map((alert) => (
          <div class="p-6 {alert.acknowledged ? 'bg-slate-50' : 'bg-red-50 border-l-4 border-red-400'}">
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-3 flex-1">
                <svg class="w-5 h-5 {alert.acknowledged ? 'text-slate' : 'text-red-600'} mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {alert.acknowledged ? (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  ) : (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  )}
                </svg>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <h4 class="font-semibold text-navy">{alert.title}</h4>
                    <span class="text-xs text-slate bg-slate-200 px-2 py-0.5 rounded-full">{alert.acknowledged ? 'Acknowledged' : alert.severity}</span>
                  </div>
                  <p class="text-sm text-slate mb-2">{alert.message}</p>
                  <div class="flex items-center gap-4 text-xs text-slate">
                    <span>{new Date(alert.timestamp).toLocaleString()}</span>
                    {alert.instance_id && <span>Instance: {alert.instance_id}</span>}
                    <span class="capitalize">{alert.type}</span>
                  </div>
                </div>
              </div>
              {!alert.acknowledged && (
                <button class="text-sm bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors" data-alert-id={alert.id}>
                  Acknowledge
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
      <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-between">
        <button id="prev-page" {pagination.offset === 0 ? 'disabled' : ''} class="text-sm text-navy hover:text-navy-light font-medium disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
        <span id="page-info" class="text-sm text-slate">Showing {pagination.offset + 1}-{Math.min(pagination.offset + pagination.limit, pagination.total)} of {pagination.total}</span>
        <button id="next-page" {!pagination.hasMore ? 'disabled' : ''} class="text-sm text-navy hover:text-navy-light font-medium disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
      </div>
      <div id="pagination-data" data-offset="{pagination.offset || 0}" data-limit="{pagination.limit || 10}" data-total="{pagination.total || 0}" data-has-more="{pagination.hasMore ? 'true' : 'false'}" class="hidden"></div>
    </div>
  </div>

  <script>
    document.querySelectorAll('[data-alert-id]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const alertId = btn.getAttribute('data-alert-id');
        const res = await fetch('/api/alerts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ alertId }),
        });
        if (res.ok) {
          window.location.reload();
        }
      });
    });

    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');
    const pageInfo = document.getElementById('page-info');
    const alertsList = document.getElementById('alerts-list');
    const paginationData = document.getElementById('pagination-data');
    let currentOffset = Number(paginationData?.getAttribute('data-offset') || 0);
    const limit = Number(paginationData?.getAttribute('data-limit') || 10);
    const total = Number(paginationData?.getAttribute('data-total') || 0);
    const hasMore = paginationData?.getAttribute('data-has-more') === 'true';

    async function loadAlerts(offset: number, queryString?: string) {
      const qs = queryString || `limit=${limit}&offset=${offset}`;
      const res = await fetch(`/api/alerts?${qs}`);
      if (!res.ok) return;
      const data = await res.json();
      const alerts = data.alerts || [];
      const pagination = data.pagination || {};

      if (alertsList) {
        alertsList.innerHTML = alerts.map((alert) => `
          <div class="p-6 ${alert.acknowledged ? 'bg-slate-50' : 'bg-red-50 border-l-4 border-red-400'}">
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-3 flex-1">
                <svg class="w-5 h-5 ${alert.acknowledged ? 'text-slate' : 'text-red-600'} mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  ${alert.acknowledged ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />' : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />'}
                </svg>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <h4 class="font-semibold text-navy">${alert.title}</h4>
                    <span class="text-xs text-slate bg-slate-200 px-2 py-0.5 rounded-full">${alert.acknowledged ? 'Acknowledged' : alert.severity}</span>
                  </div>
                  <p class="text-sm text-slate mb-2">${alert.message}</p>
                  <div class="flex items-center gap-4 text-xs text-slate">
                    <span>${new Date(alert.timestamp).toLocaleString()}</span>
                    ${alert.instance_id ? `<span>Instance: ${alert.instance_id}</span>` : ''}
                    <span class="capitalize">${alert.type}</span>
                  </div>
                </div>
              </div>
              ${!alert.acknowledged ? `<button class="text-sm bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors" data-alert-id="${alert.id}">Acknowledge</button>` : ''}
            </div>
          </div>
        `).join('');

        document.querySelectorAll('[data-alert-id]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const alertId = btn.getAttribute('data-alert-id');
            const res = await fetch('/api/alerts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ alertId }),
            });
            if (res.ok) {
              loadAlerts(currentOffset, qs);
            }
          });
        });
      }

      if (pageInfo) {
        pageInfo.textContent = `Showing ${pagination.offset + 1}-${Math.min(pagination.offset + pagination.limit, pagination.total)} of ${pagination.total}`;
      }

      if (prevBtn) prevBtn.disabled = pagination.offset === 0;
      if (nextBtn) nextBtn.disabled = !pagination.hasMore;
    }

    prevBtn?.addEventListener('click', () => {
      if (currentOffset > 0) {
        const newOffset = currentOffset - limit;
        loadAlerts(newOffset);
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (hasMore) {
        const newOffset = currentOffset + limit;
        loadAlerts(newOffset);
      }
    });

    const applyFiltersBtn = document.getElementById('apply-filters');
    const clearFiltersBtn = document.getElementById('clear-filters');
    const severitySelect = document.getElementById('filter-severity') as HTMLSelectElement | null;
    const typeSelect = document.getElementById('filter-type') as HTMLSelectElement | null;
    const acknowledgedSelect = document.getElementById('filter-acknowledged') as HTMLSelectElement | null;

    applyFiltersBtn?.addEventListener('click', () => {
      const params = new URLSearchParams();
      params.set('limit', String(limit));
      params.set('offset', '0');
      if (severitySelect?.value) params.set('severity', severitySelect.value);
      if (typeSelect?.value) params.set('type', typeSelect.value);
      if (acknowledgedSelect?.value !== '') params.set('acknowledged', acknowledgedSelect?.value || '');
      loadAlerts(0, params.toString());
    });

    clearFiltersBtn?.addEventListener('click', () => {
      if (severitySelect) severitySelect.value = '';
      if (typeSelect) typeSelect.value = '';
      if (acknowledgedSelect) acknowledgedSelect.value = '';
      loadAlerts(0, `limit=${limit}&offset=0`);
    });

    const eventSource = new EventSource('/api/alerts/stream');
    const insertedAlertIds = new Set<string>();
    eventSource.onmessage = (event) => {
      const data = JSON.parse(event.data);
      if (data.type === 'alerts') {
        const alertsList = document.getElementById('alerts-list');
        if (alertsList && data.data) {
          const newAlerts = data.data.filter((newAlert: { id: string }) => !insertedAlertIds.has(newAlert.id));
          newAlerts.forEach((alert: { id: string; severity: string; title: string; message: string; timestamp: string; acknowledged: number }) => {
            insertedAlertIds.add(alert.id);
            const alertEl = document.createElement('div');
            alertEl.className = 'p-4 border-b border-slate-100 last:border-b-0';
            alertEl.innerHTML = `
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${alert.severity === 'critical' ? 'bg-red-100 text-red-800' : alert.severity === 'warning' ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800'}">${alert.severity}</span>
                    <span class="text-sm font-medium text-navy">${alert.title}</span>
                  </div>
                  <p class="text-sm text-slate">${alert.message}</p>
                  <p class="text-xs text-slate-400 mt-1">${new Date(alert.timestamp).toLocaleString()}</p>
                </div>
                ${alert.acknowledged === 0 ? `<button data-alert-id="${alert.id}" class="acknowledge-btn text-xs bg-navy text-white px-3 py-1.5 rounded-lg hover:bg-navy-light transition-colors">Acknowledge</button>` : '<span class="text-xs text-slate-400">Acknowledged</span>'}
              </div>
            `;
            alertsList.insertBefore(alertEl, alertsList.firstChild);
          });
        }
      }
    };

    eventSource.onerror = () => {
      console.error('SSE connection error');
      eventSource.close();
    };

    let ws: WebSocket | null = null;
    function connectWebSocket() {
      const wsUrl = `${window.location.protocol === 'https:' ? 'wss:' : 'ws:'}//${window.location.host}/ws`;
      ws = new WebSocket(wsUrl);

      ws.onmessage = (event) => {
        const data = JSON.parse(event.data);
        if (data.type === 'alert') {
          const alertsList = document.getElementById('alerts-list');
          if (alertsList) {
            const alert = data.data;
            if (insertedAlertIds.has(alert.id)) return;
            insertedAlertIds.add(alert.id);
            const alertEl = document.createElement('div');
            alertEl.className = 'p-4 border-b border-slate-100 last:border-b-0';
            alertEl.innerHTML = `
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${alert.severity === 'critical' ? 'bg-red-100 text-red-800' : alert.severity === 'warning' ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800'}">${alert.severity}</span>
                    <span class="text-sm font-medium text-navy">${alert.title}</span>
                  </div>
                  <p class="text-sm text-slate">${alert.message}</p>
                  <p class="text-xs text-slate-400 mt-1">${new Date(alert.timestamp).toLocaleString()}</p>
                </div>
                ${alert.acknowledged === 0 ? `<button data-alert-id="${alert.id}" class="acknowledge-btn text-xs bg-navy text-white px-3 py-1.5 rounded-lg hover:bg-navy-light transition-colors">Acknowledge</button>` : '<span class="text-xs text-slate-400">Acknowledged</span>'}
              </div>
            `;
            alertsList.insertBefore(alertEl, alertsList.firstChild);
          }
        }
      };

      ws.onclose = () => {
        setTimeout(connectWebSocket, 3000);
      };

      ws.onerror = () => {
        ws?.close();
      };
    }

    connectWebSocket();
  </script>
</DashboardLayout>
