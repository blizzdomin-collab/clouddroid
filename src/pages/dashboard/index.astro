---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { isSubscriptionActive, getInstancesByUserId, getInvoicesByUserId, getUserByEmail } from '../../lib/database';

const instancesRes = await fetch(`${Astro.url.origin}/api/monitoring/instances`).catch(() => null);
const instancesData = instancesRes?.ok ? await instancesRes.json() : null;
const instances = instancesData?.instances || [];
const summary = instancesData?.summary || {};

const alertsRes = await fetch(`${Astro.url.origin}/api/alerts`).catch(() => null);
const alertsData = alertsRes?.ok ? await alertsRes.json() : null;
const alerts = alertsData?.alerts || [];
const alertsSummary = alertsData?.summary || {};

const subRes = await fetch(`${Astro.url.origin}/api/billing/subscription`, {
  headers: { Cookie: Astro.request.headers.get('cookie') || '' },
}).catch(() => null);
const subData = subRes?.ok ? await subRes.json() : null;
const subscription = subData?.subscription || null;
const planName = subscription?.plan || 'No active plan';
const periodEnd = subscription?.current_period_end ? new Date(subscription.current_period_end).toLocaleDateString() : null;
const isActive = isSubscriptionActive(subscription);
const isExpired = !!subscription && !isActive;
const daysLeft = isActive && subscription?.current_period_end
  ? Math.max(0, Math.ceil((new Date(subscription.current_period_end).getTime() - Date.now()) / (1000 * 60 * 60 * 24)))
  : null;
const renewSoon = isActive && daysLeft !== null && daysLeft <= 7;

const initialError = !instancesRes || !alertsRes;

const showWelcome = Astro.url.searchParams.get('welcome') === '1';
const isNewUser = instances.length === 0;

const sessionCookie = Astro.cookies.get('session');
let currentUser: any = null;
if (sessionCookie) {
  try {
    const s = JSON.parse(sessionCookie.value);
    if (s.email) currentUser = getUserByEmail(s.email);
  } catch {}
}
const userId = currentUser?.id || null;

const userInstances = userId ? getInstancesByUserId(userId) : [];
const userInstancesRunning = userInstances.filter((i) => i.status === 'running').length;
const userInstancesStopped = userInstances.filter((i) => i.status === 'stopped').length;

const userInvoices = userId ? getInvoicesByUserId(userId) : [];
const lastInvoice = userInvoices
  .filter((i) => i.status === 'paid')
  .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())[0] || null;

const activityRes = await fetch(`${Astro.url.origin}/api/auth/activity?limit=4`, {
  headers: { Cookie: Astro.request.headers.get('cookie') || '' },
}).catch(() => null);
const activityData = activityRes?.ok ? await activityRes.json() : null;
const recentActivity = activityData?.logs || [];
const totalRam = instances.reduce((a: any, b: any) => a + (b.ram || 0), 0);
---

<DashboardLayout title="Dashboard Overview - CloudDroid">
  <div class="p-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-navy dark:text-slate-100 mb-2">Dashboard Overview</h1>
      <p class="text-slate dark:text-slate-400">Welcome back! Here's what's happening with your CloudDroid instances.</p>
    </div>

    <div class="mb-8 bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class={`w-12 h-12 rounded-lg flex items-center justify-center ${isActive ? 'bg-green-50' : isExpired ? 'bg-red-50' : 'bg-slate-100'}`}>
          <svg class={`w-6 h-6 ${isActive ? 'text-green-600' : isExpired ? 'text-red-600' : 'text-slate-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <div class="text-sm text-slate mb-1">Current Plan</div>
          <div class="text-xl font-bold text-navy dark:text-slate-100">{planName}</div>
          {isActive && periodEnd && (
            <div class="text-xs text-slate mt-1">Access active until {periodEnd}</div>
          )}
          {isExpired && periodEnd && (
            <div class="text-xs text-red-600 mt-1">Access expired on {periodEnd}</div>
          )}
          {!subscription && (
            <div class="text-xs text-slate mt-1">No active subscription</div>
          )}
        </div>
      </div>
      {isExpired ? (
        <a href="/#pricing" class="inline-flex items-center justify-center bg-navy text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-navy-light transition-colors">
          Renew Access
        </a>
      ) : (
        <a href="/dashboard/billing" class="inline-flex items-center justify-center bg-navy text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-navy-light transition-colors">
          Manage Billing
        </a>
      )}
    </div>

    {isActive && daysLeft !== null && (
      <div class={`mb-8 rounded-xl border p-6 ${renewSoon ? 'bg-yellow-50 border-yellow-200' : 'bg-white dark:bg-navy-light border-slate-200 dark:border-slate-700'}`}>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <div class="text-sm text-slate mb-1">Access {renewSoon ? 'expires soon' : 'renews in'}</div>
            <div class={`text-2xl font-bold ${renewSoon ? 'text-yellow-700' : 'text-navy dark:text-slate-100'}`}>
              {daysLeft} {daysLeft === 1 ? 'day' : 'days'} remaining
            </div>
          </div>
          <a href="/#pricing" class={`inline-flex items-center justify-center px-4 py-2 rounded-lg text-sm font-semibold transition-colors ${renewSoon ? 'bg-yellow-600 text-white hover:bg-yellow-700' : 'bg-navy text-white hover:bg-navy-light'}`}>
            {renewSoon ? 'Renew Now' : 'Renew Access'}
          </a>
        </div>
        <div class="mt-4 w-full bg-slate-200 rounded-full h-2 overflow-hidden">
          <div class={`h-2 rounded-full ${renewSoon ? 'bg-yellow-500' : 'bg-navy'}`} style={`width: ${Math.min(100, Math.max(5, (daysLeft / 30) * 100))}%`}></div>
        </div>
      </div>
    )}

    {showWelcome && (
      <div class="mb-8 bg-green-50 border border-green-200 rounded-xl p-6 flex items-start gap-4">
        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-navy dark:text-slate-100 mb-1">Welcome to CloudDroid!</h2>
          <p class="text-sm text-slate">Your account is set up and your cloud Android workspaces are ready. Here's how to get the most out of your dashboard.</p>
        </div>
      </div>
    )}

    <div class="mb-8 grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/dashboard/instances" class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-4 flex items-center gap-3 hover:border-navy transition-colors">
        <div class="w-10 h-10 bg-navy/5 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-navy dark:text-slate-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
        </div>
        <span class="text-sm font-medium text-navy dark:text-slate-100">Instances</span>
      </a>
      <a href="/dashboard/monitoring" class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-4 flex items-center gap-3 hover:border-navy transition-colors">
        <div class="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <span class="text-sm font-medium text-navy dark:text-slate-100">Monitoring</span>
      </a>
      <a href="/dashboard/alerts" class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-4 flex items-center gap-3 hover:border-navy transition-colors">
        <div class="w-10 h-10 bg-yellow-50 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
        </div>
        <span class="text-sm font-medium text-navy dark:text-slate-100">Alerts</span>
      </a>
      <a href="/dashboard/billing" class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-4 flex items-center gap-3 hover:border-navy transition-colors">
        <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
        </div>
        <span class="text-sm font-medium text-navy dark:text-slate-100">Billing</span>
      </a>
    </div>

    <div class="mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-semibold text-navy dark:text-slate-100">Your Instances</h3>
          <a href="/dashboard/instances" class="text-xs text-navy dark:text-slate-100 hover:underline">View all</a>
        </div>
        <div class="text-3xl font-bold text-navy dark:text-slate-100">{userInstances.length}</div>
        <div class="text-xs text-slate mt-2">{userInstancesRunning} running • {userInstancesStopped} stopped</div>
      </div>

      <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-semibold text-navy dark:text-slate-100">Billing</h3>
          <a href="/dashboard/billing" class="text-xs text-navy dark:text-slate-100 hover:underline">Details</a>
        </div>
        {lastInvoice ? (
          <>
            <div class="text-3xl font-bold text-navy dark:text-slate-100">${lastInvoice.amount} {lastInvoice.currency}</div>
            <div class="text-xs text-slate mt-2">Last payment {new Date(lastInvoice.created_at).toLocaleDateString()}</div>
          </>
        ) : (
          <div class="text-sm text-slate mt-2">No payments yet</div>
        )}
      </div>

      <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-semibold text-navy dark:text-slate-100">Recent Activity</h3>
          <a href="/dashboard/activity" class="text-xs text-navy dark:text-slate-100 hover:underline">All</a>
        </div>
        {recentActivity.length > 0 ? (
          <ul class="space-y-2">
            {recentActivity.map((log: any) => (
              <li class="flex items-center justify-between text-xs">
                <span class="text-slate capitalize">{log.action.replace(/_/g, ' ')}</span>
                <span class="text-slate-400">{new Date(log.timestamp).toLocaleDateString()}</span>
              </li>
            ))}
          </ul>
        ) : (
          <div class="text-sm text-slate">No recent activity</div>
        )}
      </div>
    </div>

    {isNewUser && (
      <div class="mb-8 bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6">
        <h2 class="text-lg font-semibold text-navy dark:text-slate-100 mb-4">Getting Started</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="flex items-start gap-3 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg">
            <span class="w-7 h-7 bg-navy text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">1</span>
            <div>
              <div class="text-sm font-medium text-navy dark:text-slate-100">Create a workspace</div>
              <p class="text-xs text-slate mt-1">Spin up your first cloud Android instance.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg">
            <span class="w-7 h-7 bg-navy text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">2</span>
            <div>
              <div class="text-sm font-medium text-navy dark:text-slate-100">Set up monitoring</div>
              <p class="text-xs text-slate mt-1">Track CPU, memory and uptime in real time.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-4 bg-slate-50 dark:bg-slate-800 rounded-lg">
            <span class="w-7 h-7 bg-navy text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">3</span>
            <div>
              <div class="text-sm font-medium text-navy dark:text-slate-100">Configure alerts</div>
              <p class="text-xs text-slate mt-1">Get notified when something needs attention.</p>
            </div>
          </div>
        </div>
        <a href="/dashboard/instances" class="inline-flex items-center justify-center mt-4 bg-navy text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-navy-light transition-colors">
          Create your first instance
        </a>
      </div>
    )}

    <div id="error-banner" data-initial-error="{initialError ? 'true' : 'false'}" class="hidden mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-red-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span class="font-medium">Failed to load dashboard data</span>
        </div>
        <button id="retry-btn" class="text-sm bg-red-600 text-white px-3 py-1 rounded-lg hover:bg-red-700">Retry</button>
      </div>
    </div>

    <div id="dashboard-content">
      <div id="loading-overlay" class="hidden fixed inset-0 bg-white dark:bg-navy-light/80 backdrop-blur-sm z-50 flex items-center justify-center">
        <div class="flex items-center gap-3 text-navy dark:text-slate-100">
          <svg class="animate-spin h-8 w-8" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="font-medium">Loading dashboard data...</span>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-navy/5 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-navy dark:text-slate-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
          <div class="text-sm text-slate mb-1">Active Instances</div>
          <div id="total-instances" class="text-3xl font-bold text-navy dark:text-slate-100">{summary.total || 0}</div>
          <div class="text-xs text-green-600 mt-2">↑ {summary.running || 0} running</div>
        </div>
        <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
          </div>
          <div class="text-sm text-slate mb-1">Avg CPU Usage</div>
          <div id="avg-cpu" class="text-3xl font-bold text-navy dark:text-slate-100">{instances.length > 0 ? Math.round(instances.reduce((a, b) => a + b.cpu, 0) / instances.length) : 0}%</div>
          <div class="text-xs text-slate mt-2">Across all instances</div>
        </div>
        <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9z" />
              </svg>
            </div>
          </div>
          <div class="text-sm text-slate mb-1">Allocated RAM</div>
          <div class="text-3xl font-bold text-navy dark:text-slate-100">{totalRam} GB</div>
          <div class="text-xs text-slate mt-2">Across all instances</div>
        </div>
        <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-yellow-50 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
          </div>
          <div class="text-sm text-slate mb-1">Active Alerts</div>
          <div id="active-alerts" class="text-3xl font-bold text-navy dark:text-slate-100">{alertsSummary.unacknowledged || 0}</div>
          <div class="text-xs text-yellow-600 mt-2">{alertsSummary.critical || 0} requires attention</div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
            <h2 class="text-lg font-semibold text-navy dark:text-slate-100">Recent Instances</h2>
          </div>
          <div id="instances-list" class="divide-y divide-slate-200 dark:divide-slate-700">
            {instances.slice(0, 3).map((inst) => (
              <div class="p-6 flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 bg-navy/5 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-navy dark:text-slate-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <div class="font-medium text-navy dark:text-slate-100">{inst.name}</div>
                    <div class="text-sm text-slate">{inst.platform} • {inst.ram} GB RAM</div>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1.5 text-xs text-green-600 bg-green-50 px-3 py-1 rounded-full">
                  <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                  {inst.status}
                </span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
            <h2 class="text-lg font-semibold text-navy dark:text-slate-100">Recent Alerts</h2>
          </div>
          <div id="alerts-list" class="divide-y divide-slate-200 dark:divide-slate-700">
            {alerts.slice(0, 3).map((alert) => (
              <div class="p-6">
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 bg-red-50 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                  </div>
                  <div>
                    <div class="font-medium text-navy dark:text-slate-100 text-sm">{alert.title}</div>
                    <div class="text-xs text-slate mt-1">{alert.message}</div>
                    <div class="text-xs text-slate mt-1">{new Date(alert.timestamp).toLocaleString()}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const errorBanner = document.getElementById('error-banner');
    const retryBtn = document.getElementById('retry-btn');
    const dashboardContent = document.getElementById('dashboard-content');
    const initialError = errorBanner?.getAttribute('data-initial-error') === 'true';

    function showError() {
      errorBanner?.classList.remove('hidden');
      dashboardContent?.classList.add('hidden');
    }

    function hideError() {
      errorBanner?.classList.add('hidden');
      dashboardContent?.classList.remove('hidden');
    }

    async function loadDashboard() {
      const loadingOverlay = document.getElementById('loading-overlay');
      if (loadingOverlay) loadingOverlay.classList.remove('hidden');
      try {
        const [instancesRes, alertsRes] = await Promise.all([
          fetch('/api/monitoring/instances'),
          fetch('/api/alerts'),
        ]);

        if (!instancesRes.ok || !alertsRes.ok) {
          throw new Error('Failed to fetch dashboard data');
        }

        const instancesData = await instancesRes.json();
        const alertsData = await alertsRes.json();

        const instances = instancesData.instances || [];
        const summary = instancesData.summary || {};
        const alerts = alertsData.alerts || [];
        const alertsSummary = alertsData.summary || {};

        const totalInstancesEl = document.getElementById('total-instances');
        const avgCpuEl = document.getElementById('avg-cpu');
        const activeAlertsEl = document.getElementById('active-alerts');
        const instancesListEl = document.getElementById('instances-list');
        const alertsListEl = document.getElementById('alerts-list');

        if (totalInstancesEl) totalInstancesEl.textContent = String(summary.total || 0);
        if (avgCpuEl) avgCpuEl.textContent = `${instances.length > 0 ? Math.round(instances.reduce((a, b) => a + b.cpu, 0) / instances.length) : 0}%`;
        if (activeAlertsEl) {
          activeAlertsEl.textContent = String(alertsSummary.unacknowledged || 0);
          activeAlertsEl.nextElementSibling.textContent = `${alertsSummary.critical || 0} requires attention`;
        }

        if (instancesListEl) {
          instancesListEl.innerHTML = instances.slice(0, 3).map((inst) => `
            <div class="p-6 flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-navy/5 rounded-lg flex items-center justify-center">
                  <svg class="w-5 h-5 text-navy dark:text-slate-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-navy dark:text-slate-100">${inst.name}</div>
                  <div class="text-sm text-slate">${inst.platform} • ${inst.ram} GB RAM</div>
                </div>
              </div>
              <span class="inline-flex items-center gap-1.5 text-xs text-green-600 bg-green-50 px-3 py-1 rounded-full">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                ${inst.status}
              </span>
            </div>
          `).join('');
        }

        if (alertsListEl) {
          alertsListEl.innerHTML = alerts.slice(0, 3).map((alert) => `
            <div class="p-6">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 bg-red-50 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                </div>
                <div>
                  <div class="font-medium text-navy dark:text-slate-100 text-sm">${alert.title}</div>
                  <div class="text-xs text-slate mt-1">${alert.message}</div>
                  <div class="text-xs text-slate mt-1">${new Date(alert.timestamp).toLocaleString()}</div>
                </div>
              </div>
            </div>
          `).join('');
        }

        hideError();
      } catch (error) {
        showError();
      } finally {
        if (loadingOverlay) loadingOverlay.classList.add('hidden');
      }
    }

    if (initialError) {
      showError();
    }

    retryBtn?.addEventListener('click', loadDashboard);

    loadDashboard();
  </script>
</DashboardLayout>
