---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const sessionCookie = Astro.cookies.get('session');
let currentUser: { email: string; name: string; role: string } | null = null;

if (sessionCookie) {
  try {
    const session = JSON.parse(sessionCookie.value);
    if (session.authenticated === true && session.email) {
      currentUser = { email: session.email, name: session.name || 'User', role: session.role || 'user' };
    }
  } catch {
    currentUser = null;
  }
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/dashboard/instances');
}

const instanceRes = await fetch(`${Astro.url.origin}/api/instances/${id}`);
const instanceData = instanceRes.ok ? await instanceRes.json() : null;
const instance = instanceData?.instance || null;

if (!instance) {
  return Astro.redirect('/dashboard/instances');
}

const serializedMetrics = JSON.stringify(instanceData?.metrics || []);
---

<DashboardLayout title={`${instance.name} - CloudDroid`}>
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between">
      <div>
        <div class="flex items-center gap-3 mb-1">
          <a href="/dashboard/instances" class="text-sm text-slate dark:text-slate-400 hover:text-navy dark:hover:text-slate-100 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Instances
          </a>
        </div>
        <h1 class="text-2xl font-bold text-navy dark:text-slate-100">{instance.name}</h1>
        <p class="text-slate dark:text-slate-400">{instance.id} • {instance.platform}</p>
      </div>
      <span id="instance-status" class="inline-flex items-center gap-1.5 text-xs text-green-600 bg-green-50 px-3 py-1 rounded-full">
        <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
        {instance.status}
      </span>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
      <div class="card p-5">
        <div class="text-sm text-slate dark:text-slate-400 mb-1">CPU</div>
        <div id="cpu-value" class="text-3xl font-bold text-navy dark:text-slate-100">{instance.cpu}%</div>
      </div>
      <div class="card p-5">
        <div class="text-sm text-slate dark:text-slate-400 mb-1">Memory</div>
        <div id="memory-value" class="text-3xl font-bold text-navy dark:text-slate-100">{instance.memory}%</div>
      </div>
      <div class="card p-5">
        <div class="text-sm text-slate dark:text-slate-400 mb-1">Network In</div>
        <div id="network-in-value" class="text-3xl font-bold text-navy dark:text-slate-100">{instance.network_in} Mbps</div>
      </div>
      <div class="card p-5">
        <div class="text-sm text-slate dark:text-slate-400 mb-1">Network Out</div>
        <div id="network-out-value" class="text-3xl font-bold text-navy dark:text-slate-100">{instance.network_out} Mbps</div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <div class="card overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
          <h2 class="text-lg font-semibold text-navy dark:text-slate-100">CPU & Memory History</h2>
        </div>
        <div class="p-6">
          <div class="relative h-64">
            <canvas id="metrics-chart" class="w-full h-full"></canvas>
          </div>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
          <h2 class="text-lg font-semibold text-navy dark:text-slate-100">Instance Details</h2>
        </div>
        <div class="p-6 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-sm text-slate dark:text-slate-400">RAM</span>
            <span class="text-sm font-medium text-navy dark:text-slate-100">{instance.ram} GB</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-slate dark:text-slate-400">Storage</span>
            <span class="text-sm font-medium text-navy dark:text-slate-100">{instance.storage} GB</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-slate dark:text-slate-400">Platform</span>
            <span class="text-sm font-medium text-navy dark:text-slate-100">{instance.platform}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-slate dark:text-slate-400">Created</span>
            <span class="text-sm font-medium text-navy dark:text-slate-100">{new Date(instance.created_at).toLocaleString()}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-slate dark:text-slate-400">Updated</span>
            <span class="text-sm font-medium text-navy dark:text-slate-100">{new Date(instance.updated_at).toLocaleString()}</span>
          </div>
          <div>
            <span class="text-sm text-slate dark:text-slate-400 block mb-2">Tags</span>
            <div class="flex flex-wrap gap-1">
              {(instance.tags || []).map((tag: string) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-400">{tag}</span>
              ))}
            </div>
          </div>
          <div>
            <span class="text-sm text-slate dark:text-slate-400 block mb-2">Notes</span>
            <p class="text-sm text-navy dark:text-slate-100">{instance.notes || 'No notes'}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="card overflow-hidden mb-6">
      <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
        <h2 class="text-lg font-semibold text-navy dark:text-slate-100">Actions</h2>
      </div>
      <div class="p-6 flex flex-wrap gap-3">
        <button data-action="start" data-id={instance.id} class="text-sm bg-green-50 text-green-700 px-4 py-2 rounded-lg hover:bg-green-100 transition-colors">Start</button>
        <button data-action="stop" data-id={instance.id} class="text-sm bg-yellow-50 text-yellow-700 px-4 py-2 rounded-lg hover:bg-yellow-100 transition-colors">Stop</button>
        <button data-action="restart" data-id={instance.id} class="text-sm bg-blue-50 text-blue-700 px-4 py-2 rounded-lg hover:bg-blue-100 transition-colors">Restart</button>
        <button data-action="delete" data-id={instance.id} class="text-sm bg-red-50 text-red-700 px-4 py-2 rounded-lg hover:bg-red-100 transition-colors">Delete</button>
      </div>
    </div>

    <div class="bg-white dark:bg-navy-light rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
        <h2 class="text-lg font-semibold text-navy dark:text-slate-100">Recent Audit Logs</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-slate-50 dark:bg-slate-800">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate dark:text-slate-400 uppercase tracking-wider">Timestamp</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate dark:text-slate-400 uppercase tracking-wider">Event</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate dark:text-slate-400 uppercase tracking-wider">Severity</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate dark:text-slate-400 uppercase tracking-wider">Action</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate dark:text-slate-400 uppercase tracking-wider">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
            {(instanceData?.logs || []).map((log: any) => (
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate dark:text-slate-400">{new Date(log.timestamp).toLocaleString()}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-navy dark:text-slate-100">{log.event}</td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium text-blue-800 bg-blue-100">{log.severity}</span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate dark:text-slate-400">{log.action}</td>
                <td class="px-6 py-4 text-sm text-slate dark:text-slate-400">{log.details}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  <script>
    const metrics = {serializedMetrics};
    const ctx = document.getElementById('metrics-chart') as HTMLCanvasElement | null;
    if (ctx && metrics) {
      const labels = metrics.map((m: any) => new Date(m.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
      const cpu = metrics.map((m: any) => m.cpu);
      const memory = metrics.map((m: any) => m.memory);

      new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'CPU %',
              data: cpu,
              borderColor: '#0f172a',
              backgroundColor: 'rgba(15, 23, 42, 0.1)',
              tension: 0.4,
              fill: true,
            },
            {
              label: 'Memory %',
              data: memory,
              borderColor: '#3b82f6',
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              tension: 0.4,
              fill: true,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'top' } },
          scales: { y: { beginAtZero: true, max: 100 } },
        },
      });
    }

    document.querySelectorAll('[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.getAttribute('data-action');
        const id = btn.getAttribute('data-id');
        if (!action || !id) return;

        if (action === 'delete') {
          if (!confirm('Are you sure you want to delete this instance?')) return;
        }

        const endpoints: Record<string, string> = {
          start: `/api/instances/${id}/start`,
          stop: `/api/instances/${id}/stop`,
          restart: `/api/instances/${id}/restart`,
          delete: `/api/instances/${id}`,
        };

        const methods: Record<string, string> = {
          start: 'POST',
          stop: 'POST',
          restart: 'POST',
          delete: 'DELETE',
        };

        const res = await fetch(endpoints[action], { method: methods[action] });
        if (res.ok) {
          window.location.href = '/dashboard/instances';
        } else {
          alert(`Failed to ${action} instance`);
        }
      });
    });
  </script>
</DashboardLayout>
