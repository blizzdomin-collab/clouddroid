---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const sessionCookie = Astro.cookies.get('session');
let currentUser: { email: string; name: string; role: string; mollie_customer_id?: string | null; dodo_customer_id?: string | null } | null = null;
let subscription: any = null;
let invoices: any[] = [];
let instances: any[] = [];
let paymentGateway: 'dodo' | 'mollie' = 'dodo';
let cancelSuccess = false;
let cancelError = '';

if (sessionCookie) {
  try {
    const session = JSON.parse(sessionCookie.value);
    if (session.authenticated === true && session.email) {
      currentUser = { email: session.email, name: session.name || 'User', role: session.role || 'user' };
      const cookieHeader = `session=${encodeURIComponent(sessionCookie.value)}`;
      const subRes = await fetch(`${Astro.url.origin}/api/billing/subscription`, {
        headers: { Cookie: cookieHeader },
      });
      if (subRes.ok) {
        const data = await subRes.json();
        subscription = data.subscription;
        paymentGateway = data.paymentGateway || 'dodo';
      }
      const invRes = await fetch(`${Astro.url.origin}/api/billing/invoices`, {
        headers: { Cookie: cookieHeader },
      });
      if (invRes.ok) {
        const data = await invRes.json();
        invoices = data.invoices || [];
      }
      const instRes = await fetch(`${Astro.url.origin}/api/monitoring/instances`, {
        headers: { Cookie: cookieHeader },
      });
      if (instRes.ok) {
        const data = await instRes.json();
        instances = data.instances || [];
      }
    }
  } catch {
    currentUser = null;
  }
}
---

<DashboardLayout title="Billing - CloudDroid">
  <div class="p-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-navy mb-2">Billing & Subscription</h1>
      <p class="text-slate">Manage your subscription and payment methods</p>
    </div>

    {subscription ? (
      <div class="max-w-2xl space-y-6">
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200">
            <h2 class="text-lg font-semibold text-navy">Current Plan</h2>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
              <div>
                <div class="text-2xl font-bold text-navy">{subscription.plan}</div>
                <div class="text-sm text-slate">${subscription.amount}/{subscription.currency === 'USD' ? 'month' : 'month'}</div>
              </div>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium text-green-700 bg-green-100">
                {subscription.status}
              </span>
            </div>
            <div class="space-y-2 text-sm text-slate">
              <div class="flex items-center justify-between">
                <span>Current period</span>
                <span class="text-navy font-medium">{new Date(subscription.current_period_start).toLocaleDateString()} - {new Date(subscription.current_period_end).toLocaleDateString()}</span>
              </div>
              <div class="flex items-center justify-between">
                <span>Auto-renew</span>
                <span class="text-navy font-medium">{subscription.cancel_at_period_end ? 'No' : 'Yes'}</span>
              </div>
              <div class="flex items-center justify-between">
                <span>Payment method</span>
                <span class="text-navy font-medium">{paymentGateway === 'mollie' ? 'Mollie (iDEAL, Bancontact, Card)' : 'Dodo Payments (Card, Apple Pay, Google Pay)'}</span>
              </div>
              <div class="pt-4 flex items-center gap-3">
                {paymentGateway === 'dodo' && (
                  <button id="portalBtn" class="inline-flex items-center gap-2 bg-navy text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-navy-light transition-colors">
                    Manage Subscription
                  </button>
                )}
                {subscription.status === 'active' && !subscription.cancel_at_period_end && (
                  <button id="cancelBtn" class="inline-flex items-center gap-2 border border-red-300 text-red-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-red-50 transition-colors">
                    Cancel Subscription
                  </button>
                )}
              </div>
              {cancelSuccess && <p class="text-sm text-green-600 mt-2">Subscription cancellation scheduled successfully.</p>}
              {cancelError && <p class="text-sm text-red-600 mt-2">{cancelError}</p>}
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200">
            <h2 class="text-lg font-semibold text-navy">Payment Method</h2>
          </div>
          <div class="p-6">
            <p class="text-sm text-slate mb-4">Payment is processed securely by {paymentGateway === 'mollie' ? 'Mollie' : 'Dodo Payments and Mollie'}.</p>
            {paymentGateway === 'mollie' ? (
              <div class="flex items-center gap-4 p-4 bg-slate-50 rounded-lg border border-slate-200">
                <div class="w-12 h-8 bg-navy/5 rounded flex items-center justify-center">
                  <span class="text-xs font-medium text-navy">MOLLIE</span>
                </div>
                <div>
                  <div class="text-sm font-medium text-navy">Mollie</div>
                  <div class="text-xs text-slate">iDEAL, Bancontact, Card</div>
                </div>
              </div>
            ) : (
              <div class="flex items-center gap-4 p-4 bg-slate-50 rounded-lg border border-slate-200">
                <div class="w-12 h-8 bg-navy/5 rounded flex items-center justify-center">
                  <span class="text-xs font-medium text-navy">DODO</span>
                </div>
                <div>
                  <div class="text-sm font-medium text-navy">Dodo Payments</div>
                  <div class="text-xs text-slate">Card, Apple Pay, Google Pay</div>
                </div>
              </div>
            )}
          </div>
        </div>

        {instances.length > 0 && (
          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200">
              <h2 class="text-lg font-semibold text-navy">Your Instances</h2>
            </div>
            <div class="p-6">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
                <div class="bg-slate-50 rounded-lg p-4">
                  <div class="text-xs text-slate mb-1">Total</div>
                  <div class="text-xl font-bold text-navy">{instances.length}</div>
                </div>
                <div class="bg-green-50 rounded-lg p-4">
                  <div class="text-xs text-slate mb-1">Running</div>
                  <div class="text-xl font-bold text-green-700">{instances.filter((i: any) => i.status === 'running').length}</div>
                </div>
                <div class="bg-yellow-50 rounded-lg p-4">
                  <div class="text-xs text-slate mb-1">Warnings</div>
                  <div class="text-xl font-bold text-yellow-700">{instances.filter((i: any) => i.status === 'warning').length}</div>
                </div>
              </div>
              <div class="space-y-2">
                {instances.slice(0, 5).map((inst: any) => (
                  <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full {inst.status === 'running' ? 'bg-green-500' : inst.status === 'warning' ? 'bg-yellow-500' : 'bg-slate-400'}"></span>
                      <span class="text-navy font-medium">{inst.name}</span>
                    </div>
                    <span class="text-slate">{inst.platform} • {inst.ram} GB</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200">
            <h2 class="text-lg font-semibold text-navy">Billing History</h2>
          </div>
          <div class="p-6">
            {invoices.length > 0 ? (
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-slate-200">
                      <th class="text-left py-3 px-4 font-medium text-slate">Invoice</th>
                      <th class="text-left py-3 px-4 font-medium text-slate">Date</th>
                      <th class="text-left py-3 px-4 font-medium text-slate">Amount</th>
                      <th class="text-left py-3 px-4 font-medium text-slate">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {invoices.map((invoice) => (
                      <tr class="border-b border-slate-100 last:border-0">
                        <td class="py-3 px-4 text-navy font-medium">{invoice.id}</td>
                        <td class="py-3 px-4 text-slate">{new Date(invoice.created_at).toLocaleDateString()}</td>
                        <td class="py-3 px-4 text-navy">${invoice.amount} {invoice.currency}</td>
                        <td class="py-3 px-4">
                          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${invoice.status === 'paid' ? 'text-green-700 bg-green-100' : invoice.status === 'pending' ? 'text-yellow-700 bg-yellow-100' : 'text-red-700 bg-red-100'}`}>
                            {invoice.status}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="text-sm text-slate">No billing history available yet.</p>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="max-w-2xl">
        <div class="bg-white rounded-xl border border-slate-200 p-8 text-center">
          <div class="w-16 h-16 bg-navy/5 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-navy mb-2">No Active Subscription</h3>
          <p class="text-sm text-slate mb-6">You don't have an active subscription. Choose a plan to get started.</p>
          <a href="/#pricing" class="inline-flex items-center gap-2 bg-navy text-white px-6 py-3 rounded-lg font-medium hover:bg-navy-light transition-colors">
            View Plans
          </a>
        </div>
      </div>
    )}
  </div>
  {subscription && paymentGateway === 'dodo' && (
    <script>
      document.getElementById('portalBtn')?.addEventListener('click', async () => {
        try {
          const res = await fetch('/api/customer-portal');
          const data = await res.json();
          if (data.url) {
            window.location.href = data.url;
          } else {
            alert(data.error || 'Failed to open customer portal');
          }
        } catch {
          alert('Failed to open customer portal');
        }
      });
    </script>
  )}
  {subscription && (
    <script>
      document.getElementById('cancelBtn')?.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to cancel your subscription? You will retain access until the end of your current billing period.')) {
          return;
        }
        try {
          const res = await fetch('/api/billing/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cancelAtPeriodEnd: true }),
          });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            alert(data.error || 'Failed to cancel subscription');
          }
        } catch {
          alert('Failed to cancel subscription');
        }
      });
    </script>
  )}
</DashboardLayout>
