---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const instancesRes = await fetch(`${Astro.url.origin}/api/monitoring/instances`);
const instancesData = await instancesRes.json();
const instances = instancesData.instances || [];
---

<DashboardLayout title="Instances - CloudDroid">
  <div class="p-8">
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-navy mb-2">Instances</h1>
        <p class="text-slate">Manage your cloud Android workspaces</p>
      </div>
      <button id="open-modal" class="bg-navy text-white px-4 py-2 rounded-lg font-medium hover:bg-navy-light transition-colors">
        New Instance
      </button>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 p-4 mb-6">
      <div class="flex flex-wrap items-center gap-3">
        <input type="text" id="search-instances" placeholder="Search instances..." class="flex-1 min-w-[200px] px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none text-sm" />
        <select id="filter-status" class="px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none text-sm">
          <option value="">All Statuses</option>
          <option value="running">Running</option>
          <option value="stopped">Stopped</option>
          <option value="warning">Warning</option>
        </select>
        <button id="apply-filters" class="bg-navy text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-navy-light transition-colors">Apply</button>
        <button id="clear-filters" class="text-slate-700 bg-slate-100 px-4 py-2 rounded-lg text-sm font-medium hover:bg-slate-200 transition-colors">Clear</button>
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate uppercase tracking-wider">Platform</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate uppercase tracking-wider">Resources</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate uppercase tracking-wider">Tags</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-slate uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {instances.map((inst) => (
              <tr>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-navy/5 rounded-lg flex items-center justify-center">
                      <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <div>
                      <div class="font-medium text-navy">{inst.name}</div>
                      <div class="text-sm text-slate">{inst.id}</div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-slate">{inst.platform}</td>
                <td class="px-6 py-4 text-sm text-slate">{inst.ram} GB RAM • {inst.storage} GB Storage</td>
                <td class="px-6 py-4">
                  <div class="flex flex-wrap gap-1">
                    {(inst.tags || []).map((tag: string) => (
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700">{tag}</span>
                    ))}
                  </div>
                </td>
                <td class="px-6 py-4">
                  {(() => {
                    const status = inst.status;
                    const colorMap: Record<string, { text: string; bg: string; dot: string }> = {
                      running: { text: 'text-green-700', bg: 'bg-green-50', dot: 'bg-green-500' },
                      stopped: { text: 'text-slate-700', bg: 'bg-slate-100', dot: 'bg-slate-400' },
                      warning: { text: 'text-yellow-700', bg: 'bg-yellow-50', dot: 'bg-yellow-500' },
                    };
                    const colors = colorMap[status] || colorMap.running;
                    return (
                      <span id={`status-${inst.id}`} class={`inline-flex items-center gap-1.5 text-xs ${colors.text} ${colors.bg} px-3 py-1 rounded-full`}>
                        <span class={`w-1.5 h-1.5 ${colors.dot} rounded-full`}></span>
                        {status}
                      </span>
                    );
                  })()}
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <button data-action="edit" data-id={inst.id} class="text-xs bg-slate-50 text-slate-700 px-2 py-1 rounded hover:bg-slate-100">Edit</button>
                    <button data-action="start" data-id={inst.id} class="text-xs bg-green-50 text-green-700 px-2 py-1 rounded hover:bg-green-100">Start</button>
                    <button data-action="stop" data-id={inst.id} class="text-xs bg-yellow-50 text-yellow-700 px-2 py-1 rounded hover:bg-yellow-100">Stop</button>
                    <button data-action="restart" data-id={inst.id} class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded hover:bg-blue-100">Restart</button>
                    <button data-action="delete" data-id={inst.id} class="text-xs bg-red-50 text-red-700 px-2 py-1 rounded hover:bg-red-100">Delete</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4">
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-navy">New Instance</h3>
        <button id="close-modal" class="text-slate hover:text-navy">✕</button>
      </div>
      <form id="create-form" class="p-6 space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-navy mb-1">Name</label>
          <input type="text" id="name" name="name" required class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none" placeholder="QA-Test-Android-14" />
        </div>
        <div>
          <label for="platform" class="block text-sm font-medium text-navy mb-1">Platform</label>
          <select id="platform" name="platform" required class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none">
            <option value="Android 14">Android 14</option>
            <option value="Android 13">Android 13</option>
            <option value="Android 12">Android 12</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="ram" class="block text-sm font-medium text-navy mb-1">RAM (GB)</label>
            <input type="number" id="ram" name="ram" required min="1" max="32" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none" placeholder="8" />
          </div>
          <div>
            <label for="storage" class="block text-sm font-medium text-navy mb-1">Storage (GB)</label>
            <input type="number" id="storage" name="storage" required min="8" max="512" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none" placeholder="64" />
          </div>
        </div>
        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" id="cancel-modal" class="px-4 py-2 text-sm text-slate hover:text-navy">Cancel</button>
          <button type="submit" class="bg-navy text-white px-4 py-2 rounded-lg font-medium hover:bg-navy-light transition-colors">Create Instance</button>
        </div>
      </form>
    </div>
  </div>

  <div id="edit-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4">
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-navy">Edit Instance</h3>
        <button id="close-edit-modal" class="text-slate hover:text-navy">✕</button>
      </div>
      <form id="edit-form" class="p-6 space-y-4">
        <input type="hidden" id="edit-instance-id" />
        <div>
          <label for="edit-tags" class="block text-sm font-medium text-navy mb-1">Tags (comma-separated)</label>
          <input type="text" id="edit-tags" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none" placeholder="qa, test, production" />
        </div>
        <div>
          <label for="edit-notes" class="block text-sm font-medium text-navy mb-1">Notes</label>
          <textarea id="edit-notes" rows="3" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none" placeholder="Instance notes..."></textarea>
        </div>
        <div id="edit-error" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800"></div>
        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" id="cancel-edit-modal" class="px-4 py-2 text-sm text-slate hover:text-navy">Cancel</button>
          <button type="submit" class="bg-navy text-white px-4 py-2 rounded-lg font-medium hover:bg-navy-light transition-colors">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('modal');
    const openBtn = document.getElementById('open-modal');
    const closeBtn = document.getElementById('close-modal');
    const cancelBtn = document.getElementById('cancel-modal');
    const form = document.getElementById('create-form');

    openBtn?.addEventListener('click', () => {
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    });

    const hideModal = () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    };

    closeBtn?.addEventListener('click', hideModal);
    cancelBtn?.addEventListener('click', hideModal);

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form as HTMLFormElement);
      const data = {
        name: (formData.get('name') as string).trim(),
        platform: formData.get('platform') as string,
        ram: Number(formData.get('ram')),
        storage: Number(formData.get('storage')),
      };

      const res = await fetch('/api/instances', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to create instance');
      }
    });

    document.querySelectorAll('[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.getAttribute('data-action');
        const id = btn.getAttribute('data-id');
        if (!action || !id) return;

        if (action === 'delete') {
          if (!confirm('Are you sure you want to delete this instance?')) return;
        }

        const endpoints: Record<string, string> = {
          start: `/api/instances/${id}/start`,
          stop: `/api/instances/${id}/stop`,
          restart: `/api/instances/${id}/restart`,
          delete: `/api/instances/${id}`,
        };

        const methods: Record<string, string> = {
          start: 'POST',
          stop: 'POST',
          restart: 'POST',
          delete: 'DELETE',
        };

        const res = await fetch(endpoints[action], { method: methods[action] });
        if (res.ok) {
          window.location.reload();
        } else {
          alert(`Failed to ${action} instance`);
        }
      });
    });

    const searchInput = document.getElementById('search-instances') as HTMLInputElement;
    const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;
    const applyBtn = document.getElementById('apply-filters');
    const clearBtn = document.getElementById('clear-filters');

    const filterInstances = () => {
      const query = searchInput?.value.toLowerCase() || '';
      const status = statusFilter?.value || '';

      document.querySelectorAll('tbody tr').forEach((row) => {
        const text = row.textContent?.toLowerCase() || '';
        const statusCell = row.querySelector('td:nth-child(5)')?.textContent?.toLowerCase() || '';
        const matchesQuery = text.includes(query);
        const matchesStatus = !status || statusCell.includes(status);
        row.style.display = matchesQuery && matchesStatus ? '' : 'none';
      });
    };

    applyBtn?.addEventListener('click', filterInstances);
    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (statusFilter) statusFilter.value = '';
      filterInstances();
    });
    searchInput?.addEventListener('input', filterInstances);
    statusFilter?.addEventListener('change', filterInstances);

    const editModal = document.getElementById('edit-modal');
    const closeEditModal = document.getElementById('close-edit-modal');
    const cancelEditModal = document.getElementById('cancel-edit-modal');
    const editForm = document.getElementById('edit-form');

    document.querySelectorAll('[data-action="edit"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!id) return;

        const res = await fetch(`/api/instances/${id}`);
        if (!res.ok) {
          alert('Failed to load instance');
          return;
        }
        const instance = await res.json();
        const editId = document.getElementById('edit-instance-id') as HTMLInputElement;
        const editTags = document.getElementById('edit-tags') as HTMLInputElement;
        const editNotes = document.getElementById('edit-notes') as HTMLTextAreaElement;
        if (editId) editId.value = instance.id;
        if (editTags) editTags.value = (instance.tags || []).join(', ');
        if (editNotes) editNotes.value = instance.notes || '';

        if (editModal) {
          editModal.classList.remove('hidden');
          editModal.classList.add('flex');
        }
      });
    });

    const hideEditModal = () => {
      if (editModal) {
        editModal.classList.add('hidden');
        editModal.classList.remove('flex');
      }
    };

    closeEditModal?.addEventListener('click', hideEditModal);
    cancelEditModal?.addEventListener('click', hideEditModal);

    editForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('edit-instance-id') as HTMLInputElement)?.value;
      const tagsInput = (document.getElementById('edit-tags') as HTMLInputElement)?.value || '';
      const notes = (document.getElementById('edit-notes') as HTMLTextAreaElement)?.value || '';
      const tags = tagsInput.split(',').map((t) => t.trim()).filter((t) => t.length > 0);

      const res = await fetch(`/api/instances/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tags, notes }),
      });

      if (res.ok) {
        hideEditModal();
        window.location.reload();
      } else {
        const errorEl = document.getElementById('edit-error');
        if (errorEl) {
          errorEl.textContent = 'Failed to update instance';
          errorEl.classList.remove('hidden');
        }
      }
    });
  </script>
</DashboardLayout>
