---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const sessionCookie = Astro.cookies.get('session');
let isAdmin = false;
let userData: any = null;
let error: string | null = null;

if (sessionCookie) {
  try {
    const session = JSON.parse(sessionCookie.value);
    if (session.authenticated === true && session.role === 'admin') {
      isAdmin = true;
      const res = await fetch(`${Astro.url.origin}/api/admin/users/${Astro.params.id}`);
      if (res.ok) {
        userData = await res.json();
      } else if (res.status === 404) {
        error = 'User not found';
      } else {
        error = 'Failed to load user data';
      }
    }
  } catch {
    isAdmin = false;
  }
}
---

<DashboardLayout title={`User Details - ${userData?.user?.name || 'User'} - CloudDroid`}>
  <div class="p-8">
    {isAdmin ? (
      error ? (
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-800">{error}</div>
      ) : userData ? (
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <a href="/dashboard/users" class="text-sm text-slate hover:text-navy transition-colors">← Back to Users</a>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <div class="flex items-start justify-between">
              <div>
                <h1 class="text-2xl font-bold text-navy mb-1">{userData.user.name}</h1>
                <p class="text-slate">{userData.user.email}</p>
              </div>
              <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${userData.user.suspended ? 'text-red-700 bg-red-100' : 'text-green-700 bg-green-100'}`}>
                {userData.user.suspended ? 'Suspended' : 'Active'}
              </span>
            </div>
            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              <div>
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Role</div>
                <div class="text-sm text-navy capitalize">{userData.user.role}</div>
              </div>
              <div>
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Created</div>
                <div class="text-sm text-navy">{new Date(userData.user.created_at).toLocaleDateString()}</div>
              </div>
              <div>
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">2FA</div>
                <div class="text-sm text-navy">{userData.user.two_factor_enabled ? 'Enabled' : 'Disabled'}</div>
              </div>
              <div>
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Registration IP</div>
                <div class="text-sm text-navy">{userData.user.registration_ip || 'N/A'}</div>
              </div>
            </div>
            <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Dodo Customer ID</div>
                <div class="text-sm text-navy">{userData.user.dodo_customer_id || 'N/A'}</div>
              </div>
              <div>
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Mollie Customer ID</div>
                <div class="text-sm text-navy">{userData.user.mollie_customer_id || 'N/A'}</div>
              </div>
              <div>
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">PayNow Customer ID</div>
                <div class="text-sm text-navy">{userData.user.paynow_customer_id || 'N/A'}</div>
              </div>
              <div>
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">EasyTransac Client ID</div>
                <div class="text-sm text-navy">{userData.user.easytransac_client_id || 'N/A'}</div>
              </div>
            </div>
            {userData.user.suspension_reason && (
              <div class="mt-4">
                <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Suspension Reason</div>
                <div class="text-sm text-red-700">{userData.user.suspension_reason}</div>
              </div>
            )}
          </div>

          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200">
              <h2 class="text-lg font-semibold text-navy">Instances ({userData.instances.length})</h2>
            </div>
            <div class="p-6">
              {userData.instances.length > 0 ? (
                <div class="overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b border-slate-200">
                        <th class="text-left py-3 px-4 font-medium text-slate">Name</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Platform</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Resources</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Status</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Created</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {userData.instances.map((instance: any) => (
                        <tr>
                          <td class="py-3 px-4 text-navy font-medium">{instance.name}</td>
                          <td class="py-3 px-4 text-slate">{instance.platform}</td>
                          <td class="py-3 px-4 text-slate">{instance.ram}GB RAM / {instance.storage}GB</td>
                          <td class="py-3 px-4">
                            <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${instance.status === 'running' ? 'text-green-700 bg-green-100' : instance.status === 'stopped' ? 'text-yellow-700 bg-yellow-100' : 'text-red-700 bg-red-100'}`}>
                              {instance.status}
                            </span>
                          </td>
                          <td class="py-3 px-4 text-slate">{new Date(instance.created_at).toLocaleDateString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <p class="text-sm text-slate">No instances yet.</p>
              )}
            </div>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200">
              <h2 class="text-lg font-semibold text-navy">Subscriptions ({userData.subscriptions.length})</h2>
            </div>
            <div class="p-6">
              {userData.subscriptions.length > 0 ? (
                <div class="overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b border-slate-200">
                        <th class="text-left py-3 px-4 font-medium text-slate">Plan</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Status</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Amount</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Period</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {userData.subscriptions.map((sub: any) => (
                        <tr>
                          <td class="py-3 px-4 text-navy font-medium capitalize">{sub.plan}</td>
                          <td class="py-3 px-4">
                            <span className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${sub.status === 'active' ? 'text-green-700 bg-green-100' : sub.status === 'cancelled' ? 'text-red-700 bg-red-100' : 'text-yellow-700 bg-yellow-100'}`}>
                              {sub.status}
                            </span>
                          </td>
                          <td class="py-3 px-4 text-slate">{sub.currency} {sub.amount.toFixed(2)}</td>
                          <td class="py-3 px-4 text-slate">
                            {new Date(sub.current_period_start).toLocaleDateString()} - {new Date(sub.current_period_end).toLocaleDateString()}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <p class="text-sm text-slate">No subscriptions yet.</p>
              )}
            </div>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200">
              <h2 class="text-lg font-semibold text-navy">Invoices ({userData.invoices.length})</h2>
            </div>
            <div class="p-6">
              {userData.invoices.length > 0 ? (
                <div class="overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b border-slate-200">
                        <th class="text-left py-3 px-4 font-medium text-slate">Invoice ID</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Amount</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Status</th>
                        <th class="text-left py-3 px-4 font-medium text-slate">Date</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {userData.invoices.map((invoice: any) => (
                        <tr>
                          <td class="py-3 px-4 text-navy font-medium">{invoice.id}</td>
                          <td class="py-3 px-4 text-slate">{invoice.currency} {invoice.amount.toFixed(2)}</td>
                          <td class="py-3 px-4">
                            <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${invoice.status === 'paid' ? 'text-green-700 bg-green-100' : invoice.status === 'pending' ? 'text-yellow-700 bg-yellow-100' : 'text-red-700 bg-red-100'}`}>
                              {invoice.status}
                            </span>
                          </td>
                          <td class="py-3 px-4 text-slate">{new Date(invoice.created_at).toLocaleDateString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <p class="text-sm text-slate">No invoices yet.</p>
              )}
            </div>
          </div>
        </div>
      ) : null
    ) : (
      <div class="bg-white rounded-xl border border-slate-200 p-8 text-center">
        <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 002 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-navy mb-2">Access Denied</h3>
        <p class="text-sm text-slate">You need admin privileges to view this page.</p>
      </div>
    )}
  </div>
</DashboardLayout>
