---
import Layout from '../layouts/Layout.astro';

interface Announcement {
  id: number;
  title: string;
  message: string;
  type: 'info' | 'changelog' | 'maintenance' | 'feature';
  status: string;
  created_at: string;
  updated_at: string;
}

let announcements: Announcement[] = [];
let error: string | null = null;

try {
  const res = await fetch(`${Astro.url.origin}/api/announcements`);
  if (res.ok) {
    const data = await res.json();
    announcements = data.announcements || [];
  } else {
    error = 'Failed to load announcements';
  }
} catch {
  error = 'Failed to load announcements';
}

const typeColors: Record<string, string> = {
  changelog: 'bg-blue-100 text-blue-800 border-blue-200',
  maintenance: 'bg-yellow-100 text-yellow-800 border-yellow-200',
  feature: 'bg-green-100 text-green-800 border-green-200',
  info: 'bg-slate-100 text-slate-800 border-slate-200',
};

const typeLabels: Record<string, string> = {
  changelog: 'Changelog',
  maintenance: 'Maintenance',
  feature: 'New Feature',
  info: 'Info',
};
---

<Layout title="Changelog - CloudDroid" description="Latest updates, new features, and maintenance notices from CloudDroid.">
  <div class="bg-slate-light py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-bold text-navy mb-4">Changelog</h1>
      <p class="text-lg text-slate">Latest updates, new features, and maintenance notices from CloudDroid.</p>
    </div>
  </div>

  <div class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {error && (
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-6 text-center">
          {error}
        </div>
      )}

      {!error && announcements.length === 0 && (
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-12 text-center">
          <svg class="w-12 h-12 text-slate mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9a2 2 0 00-2 2v1" />
          </svg>
          <p class="text-slate font-medium">No announcements yet.</p>
          <p class="text-sm text-slate mt-1">Check back later for updates.</p>
        </div>
      )}

      <div class="space-y-6">
        {announcements.map((announcement) => (
          <article class="bg-slate-50 rounded-2xl border border-slate-200 p-6 sm:p-8 hover:border-navy/20 transition-colors">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ${typeColors[announcement.type] || typeColors.info}`}>
                {typeLabels[announcement.type] || announcement.type}
              </span>
              <time class="text-xs text-slate" datetime={announcement.created_at}>
                {new Date(announcement.created_at).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </div>
            <h2 class="text-xl font-bold text-navy mb-3">{announcement.title}</h2>
            <div class="text-slate leading-relaxed whitespace-pre-wrap">{announcement.message}</div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>
