---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Real-Time Alerts - CloudDroid" description="Live compliance and security alerts for CloudDroid instances">
  <div class="min-h-screen bg-slate-light py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-navy mb-2">Real-Time Alerts</h1>
          <p class="text-slate">Live compliance and security monitoring</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
          <span class="text-sm text-slate">Live</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <div class="text-sm text-slate mb-1">Total Alerts</div>
          <div class="text-3xl font-bold text-navy" id="total-alerts">-</div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <div class="text-sm text-slate mb-1">Unacknowledged</div>
          <div class="text-3xl font-bold text-red-600" id="unacknowledged-alerts">-</div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <div class="text-sm text-slate mb-1">Critical</div>
          <div class="text-3xl font-bold text-red-600" id="critical-alerts">-</div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6">
          <div class="text-sm text-slate mb-1">Warnings</div>
          <div class="text-3xl font-bold text-yellow-600" id="warning-alerts">-</div>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200">
          <h2 class="text-lg font-semibold text-navy">Active Alerts</h2>
        </div>
        <div class="divide-y divide-slate-200" id="alerts-container">
          <div class="p-6 text-center text-slate">Loading...</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const getSeverityColor = (severity: string) => {
      switch (severity) {
        case 'critical':
          return 'red';
        case 'warning':
          return 'yellow';
        default:
          return 'blue';
      }
    };

    const getTypeIcon = (type: string) => {
      switch (type) {
        case 'cpu':
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />';
        case 'network':
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />';
        case 'aup':
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />';
        case 'security':
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />';
        default:
          return '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />';
      }
    };

    const loadAlerts = async () => {
      try {
        const response = await fetch('/api/alerts');
        const data = await response.json();

        document.getElementById('total-alerts')!.textContent = String(data.summary.total);
        document.getElementById('unacknowledged-alerts')!.textContent = String(data.summary.unacknowledged);
        document.getElementById('critical-alerts')!.textContent = String(data.summary.critical);
        document.getElementById('warning-alerts')!.textContent = String(data.summary.warning);

        const container = document.getElementById('alerts-container')!;
        if (data.alerts.length === 0) {
          container.innerHTML = '<div class="p-6 text-center text-slate">No active alerts</div>';
          return;
        }

        container.innerHTML = data.alerts
          .map((alert: RealtimeAlert) => {
            const color = getSeverityColor(alert.severity);
            return `
            <div class="p-6 ${alert.acknowledged ? 'bg-slate-50' : 'bg-' + color + '-50'} border-l-4 border-${color}-400">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-start gap-3 flex-1">
                  <svg class="w-5 h-5 text-${color}-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    ${getTypeIcon(alert.type)}
                  </svg>
                  <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                      <h4 class="font-semibold text-navy">${alert.title}</h4>
                      ${alert.acknowledged ? '<span class="text-xs text-slate bg-slate-200 px-2 py-0.5 rounded-full">Acknowledged</span>' : ''}
                    </div>
                    <p class="text-sm text-slate mb-2">${alert.message}</p>
                    <div class="flex items-center gap-4 text-xs text-slate">
                      <span>${new Date(alert.timestamp).toLocaleString()}</span>
                      ${alert.instanceId ? `<span>Instance: ${alert.instanceId}</span>` : ''}
                      <span class="capitalize">${alert.type}</span>
                    </div>
                  </div>
                </div>
                ${!alert.acknowledged ? `
                  <button
                    onclick="acknowledgeAlert('${alert.id}')"
                    class="text-sm bg-${color}-600 text-white px-4 py-2 rounded-lg hover:bg-${color}-700 transition-colors"
                  >
                    Acknowledge
                  </button>
                ` : ''}
              </div>
            </div>
          `;
          })
          .join('');
      } catch (error) {
        console.error('Failed to fetch alerts:', error);
      }
    };

    window.acknowledgeAlert = async (alertId: string) => {
      try {
        await fetch('/api/alerts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ alertId }),
        });
        loadAlerts();
      } catch (error) {
        console.error('Failed to acknowledge alert:', error);
      }
    };

    loadAlerts();
    setInterval(loadAlerts, 5000);
  </script>
</Layout>
