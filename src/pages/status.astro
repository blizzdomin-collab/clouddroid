---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

interface ServiceStatus {
  name: string;
  status: 'operational' | 'degraded' | 'outage';
  latency?: number;
}

const services: ServiceStatus[] = [
  { name: 'API Services', status: 'operational' },
  { name: 'Web Dashboard', status: 'operational' },
  { name: 'Instance Provisioning', status: 'operational' },
  { name: 'Monitoring', status: 'operational' },
  { name: 'Alerting', status: 'operational' },
  { name: 'Billing', status: 'operational' },
];

let healthData: any = null;
let monitoringData: any = null;

try {
  const healthRes = await fetch(`${Astro.url.origin}/api/health`);
  if (healthRes.ok) {
    healthData = await healthRes.json();
  }
} catch {}

try {
  const monitoringRes = await fetch(`${Astro.url.origin}/api/monitoring/instances`);
  if (monitoringRes.ok) {
    monitoringData = await monitoringRes.json();
  }
} catch {}

if (healthData?.status === 'healthy') {
  services.forEach(s => s.status = 'operational');
} else if (healthData?.status === 'degraded') {
  services[0].status = 'degraded';
  services[1].status = 'degraded';
}

const overallStatus = services.every(s => s.status === 'operational') ? 'operational' : 'degraded';
const statusColor = overallStatus === 'operational' ? 'green' : 'yellow';
const statusText = overallStatus === 'operational' ? 'All Systems Operational' : 'Some Systems Degraded';
---

<Layout title="Status - CloudDroid" description="Real-time operational status and uptime information for CloudDroid services.">
  <div class="bg-slate-light py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-3 h-3 bg-{statusColor}-500 rounded-full animate-pulse"></div>
        <h1 class="text-4xl font-bold text-navy">{statusText}</h1>
      </div>
      <p class="text-slate text-lg">Real-time operational status and uptime information for CloudDroid services.</p>
      <p class="text-sm text-slate mt-2">Last checked: {new Date().toLocaleString()}</p>
    </div>
  </div>

  <div class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-3 h-3 bg-{service.status === 'operational' ? 'green' : service.status === 'degraded' ? 'yellow' : 'red'}-500 rounded-full"></div>
              <div class="text-sm font-medium text-navy">{service.name}</div>
            </div>
            <div class="text-xs text-slate capitalize">{service.status === 'operational' ? 'Operational' : service.status === 'degraded' ? 'Degraded Performance' : 'Service Outage'}</div>
            {service.latency && <div class="text-xs text-slate mt-1">Latency: {service.latency}ms</div>}
          </div>
        ))}
      </div>

      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200">
          <h2 class="text-lg font-semibold text-navy">Incident History</h2>
        </div>
        <div class="divide-y divide-slate-200">
          <div class="px-6 py-4">
            <div class="flex items-center justify-between mb-1">
              <div class="text-sm font-medium text-navy">No active incidents</div>
              <span class="text-xs text-green-600 bg-green-50 px-2 py-1 rounded-full">All systems operational</span>
            </div>
            <div class="text-xs text-slate">Last checked: {new Date().toLocaleString()}</div>
          </div>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <h2 class="text-lg font-semibold text-navy mb-4">Uptime Commitment</h2>
        <p class="text-sm text-slate mb-4">CloudDroid targets 99.9% uptime for production services. Enterprise tier subscriptions include formal SLA commitments with service credits for qualifying downtime.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Target Uptime</div>
            <div class="text-2xl font-bold text-navy">99.9%</div>
          </div>
          <div>
            <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Maintenance Window</div>
            <div class="text-2xl font-bold text-navy">Sundays</div>
          </div>
          <div>
            <div class="text-xs font-medium text-slate uppercase tracking-wider mb-1">Support Response</div>
            <div class="text-2xl font-bold text-navy">&lt;24h</div>
          </div>
        </div>
      </div>

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <h2 class="text-lg font-semibold text-navy mb-4">Subscribe to Updates</h2>
        <p class="text-sm text-slate mb-4">Receive notifications about service status changes, maintenance windows, and incidents.</p>
        <form id="status-subscribe" class="flex gap-3">
          <input type="email" placeholder="you@company.com" class="flex-1 px-4 py-2 border border-slate-200 rounded-lg text-sm" required />
          <button type="submit" class="bg-navy text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-navy-light transition-colors">Subscribe</button>
        </form>
        <div id="status-subscribe-result" class="mt-3 text-sm hidden"></div>
      </div>

    </div>
  </div>

  <script>
    const form = document.getElementById('status-subscribe');
    const result = document.getElementById('status-subscribe-result');
    form?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const email = form.email.value;
      if (!email) return;
      result.textContent = 'Status page is currently read-only. Subscribe to updates via our newsletter or contact support@clouddroid.eu for incident notifications.';
      result.className = 'mt-3 text-sm text-slate';
      result.classList.remove('hidden');
    });
  </script>
</Layout>