---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Status - CloudDroid" description="CloudDroid operational status and service health.">
  <div class="bg-slate-light py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-navy mb-4">Status</h1>
      <p class="text-slate text-lg">Operational status for CloudDroid services.</p>
    </div>
  </div>
  <div class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <section>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold text-navy">Web Application & API</h2>
              <p class="text-sm text-slate mt-1">clouddroid.eu</p>
            </div>
            <span id="app-status" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-200 text-slate-700">Checking...</span>
          </div>
        </div>
      </section>

      <section>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold text-navy">Real-time Services</h2>
              <p class="text-sm text-slate mt-1">WebSocket and Redis-backed updates</p>
            </div>
            <span id="ws-status" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-200 text-slate-700">Checking...</span>
          </div>
        </div>
      </section>

      <section>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
          <h2 class="text-xl font-bold text-navy mb-2">API Health</h2>
          <p class="text-sm text-slate mb-3">Machine-readable health endpoint:</p>
          <code class="block bg-navy text-slate-200 rounded-lg p-4 text-sm">GET /api/health</code>
          <p class="text-xs text-slate mt-2">Last checked: <span id="health-checked">—</span></p>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-navy mb-4">Incident History</h2>
        <div class="space-y-4">
          <div class="border border-slate-200 rounded-xl p-5">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-navy">No incidents reported</span>
              <span class="text-xs text-slate-500">Since monitoring began</span>
            </div>
            <p class="text-sm text-slate">This timeline will be updated if any service interruptions occur.</p>
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    const appStatus = document.getElementById('app-status');
    const wsStatus = document.getElementById('ws-status');
    const healthChecked = document.getElementById('health-checked');

    async function checkHealth() {
      try {
        const res = await fetch('/api/health');
        const data = await res.json();
        const ok = res.ok && data.status === 'healthy';
        appStatus.textContent = ok ? 'Operational' : 'Degraded';
        appStatus.className = `inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${ok ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`;
        healthChecked.textContent = new Date(data.timestamp).toLocaleString();
      } catch (e) {
        appStatus.textContent = 'Unreachable';
        appStatus.className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800';
        healthChecked.textContent = new Date().toLocaleString();
      }
    }

    async function checkWs() {
      try {
        const ws = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/ws`);
        await new Promise((resolve, reject) => {
          ws.onopen = resolve;
          ws.onerror = reject;
          setTimeout(() => reject(new Error('timeout')), 4000);
        });
        wsStatus.textContent = 'Operational';
        wsStatus.className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800';
        ws.close();
      } catch (e) {
        wsStatus.textContent = 'Unreachable';
        wsStatus.className = 'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800';
      }
    }

    checkHealth();
    checkWs();
  </script>
</Layout>
