---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found - CloudDroid">
  <div class="min-h-[60vh] flex items-center justify-center p-8">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-navy mb-4">404</h1>
      <p class="text-xl text-slate mb-8">The page you're looking for doesn't exist.</p>
      <a href="/" class="inline-flex items-center gap-2 bg-navy text-white px-6 py-3 rounded-lg font-medium hover:bg-navy-light transition-colors">
        Go Home
      </a>
    </div>
  </div>
</Layout>
