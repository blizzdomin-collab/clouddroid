---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

interface Props {
  plan: string;
}

const planConfig: Record<string, { name: string; price: number; interval: string; specs: string[]; description: string; mollieAmount: string; paynowAmount: string; easytransacAmount: string }> = {
  developer: {
    name: 'Developer',
    price: 49,
    interval: 'one-time',
    description: 'For individual developers and small projects',
    specs: ['4 GB RAM', '32 GB Storage', '1 Concurrent Instance', 'Email Support'],
    mollieAmount: '49.00',
    paynowAmount: '49.00',
    easytransacAmount: '49.00',
  },
  professional: {
    name: 'Professional',
    price: 149,
    interval: 'one-time',
    description: 'For growing teams and production workloads',
    specs: ['8 GB RAM', '64 GB Storage', '4 Concurrent Instances', 'Priority Support', 'CI/CD Integrations'],
    mollieAmount: '149.00',
    paynowAmount: '149.00',
    easytransacAmount: '149.00',
  },
  team: {
    name: 'Team',
    price: 399,
    interval: 'one-time',
    description: 'For organizations requiring maximum scale',
    specs: ['16 GB RAM', '128 GB Storage', '12 Concurrent Instances', '24/7 Dedicated Support', '99.9% Uptime SLA'],
    mollieAmount: '399.00',
    paynowAmount: '399.00',
    easytransacAmount: '399.00',
  },
};

const { plan } = Astro.params;
const selectedPlan = planConfig[plan];

if (!selectedPlan) {
  return Astro.redirect('/#pricing');
}
---

<Layout title={`Checkout - ${selectedPlan.name} Plan`} description={`Purchase CloudDroid ${selectedPlan.name} plan`}>
  <div class="min-h-screen bg-slate-light py-12 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/#pricing" class="inline-flex items-center gap-2 text-sm text-slate hover:text-navy transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to pricing
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
          <div class="bg-navy px-8 py-6">
            <h1 class="text-2xl font-bold text-white">Complete Your Purchase</h1>
            <p class="text-slate-300 mt-1">One-time payment. Renew anytime to extend your access.</p>
          </div>
          <div class="p-8">
            <div class="mb-8">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h2 class="text-lg font-semibold text-navy">{selectedPlan.name} Plan</h2>
                  <p class="text-sm text-slate mt-1">{selectedPlan.description}</p>
                </div>
                <div class="text-right">
                  <div class="text-3xl font-bold text-navy">${selectedPlan.price}</div>
                  <div class="text-sm text-slate">one-time payment</div>
                  <div class="text-xs text-slate mt-1">Excl. applicable taxes and VAT</div>
                </div>
              </div>
              <ul class="space-y-3">
                {selectedPlan.specs.map((spec) => (
                  <li class="flex items-center gap-3 text-sm text-slate">
                    <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {spec}
                  </li>
                ))}
              </ul>
            </div>

            <div class="border-t border-slate-200 pt-6">
              <h3 class="text-sm font-semibold text-navy uppercase tracking-wider mb-4">What's Included</h3>
              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <div>
                    <div class="text-sm font-medium text-navy">SSL Encrypted</div>
                    <div class="text-xs text-slate">All transactions secured with TLS 1.3</div>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <div>
                    <div class="text-sm font-medium text-navy">One-Time Payment</div>
                    <div class="text-xs text-slate">No recurring charges. Extend access anytime.</div>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <div>
                    <div class="text-sm font-medium text-navy">Instant Access</div>
                    <div class="text-xs text-slate">Dashboard access immediately after payment</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
          <div class="p-8">
            <h2 class="text-lg font-semibold text-navy mb-6">Payment Details</h2>
            <form id="checkout-form" data-plan={plan} class="space-y-6">
              <div>
                <label for="email" class="block text-sm font-medium text-navy mb-2">
                  Email Address
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-navy focus:border-transparent outline-none transition-all"
                  placeholder="you@company.com"
                />
                <p class="text-xs text-slate mt-1">We'll send your receipt and dashboard access to this email.</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-navy mb-3">
                  Select Payment Method
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <label class="cursor-pointer relative">
                    <input type="radio" name="gateway" value="dodo" class="sr-only peer" />
                    <div class="border-2 border-slate-200 rounded-xl p-5 peer-checked:border-navy peer-checked:bg-navy/5 transition-all hover:border-slate-300">
                      <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-navy/5 rounded-lg flex items-center justify-center">
                          <svg class="w-6 h-6 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                          </svg>
                        </div>
                        <div>
                          <div class="text-sm font-semibold text-navy">Dodo Payments</div>
                          <div class="text-xs text-slate">Card, Apple Pay, Google Pay</div>
                        </div>
                      </div>
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-slate">USD pricing</span>
                        <span class="text-xs font-medium text-navy">${selectedPlan.price}</span>
                      </div>
                    </div>
                  </label>
                  <label class="cursor-pointer relative">
                    <input type="radio" name="gateway" value="mollie" class="sr-only peer" />
                    <div class="border-2 border-slate-200 rounded-xl p-5 peer-checked:border-navy peer-checked:bg-navy/5 transition-all hover:border-slate-300">
                      <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-navy/5 rounded-lg flex items-center justify-center">
                          <svg class="w-6 h-6 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                        </div>
                        <div>
                          <div class="text-sm font-semibold text-navy">Mollie</div>
                          <div class="text-xs text-slate">iDEAL, Bancontact, Card</div>
                        </div>
                      </div>
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-slate">EUR pricing</span>
                        <span class="text-xs font-medium text-navy">€{selectedPlan.mollieAmount}</span>
                      </div>
                    </div>
                  </label>
                  <label class="cursor-pointer relative">
                    <input type="radio" name="gateway" value="paynow" class="sr-only peer" />
                    <div class="border-2 border-slate-200 rounded-xl p-5 peer-checked:border-navy peer-checked:bg-navy/5 transition-all hover:border-slate-300">
                      <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-navy/5 rounded-lg flex items-center justify-center">
                          <svg class="w-6 h-6 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                          </svg>
                        </div>
                        <div>
                          <div class="text-sm font-semibold text-navy">PayNow</div>
                          <div class="text-xs text-slate">Card</div>
                        </div>
                      </div>
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-slate">USD pricing</span>
                        <span class="text-xs font-medium text-navy">${selectedPlan.paynowAmount}</span>
                      </div>
                    </div>
                  </label>
                  <label class="cursor-pointer relative">
                    <input type="radio" name="gateway" value="easytransac" class="sr-only peer" />
                    <div class="border-2 border-slate-200 rounded-xl p-5 peer-checked:border-navy peer-checked:bg-navy/5 transition-all hover:border-slate-300">
                      <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-navy/5 rounded-lg flex items-center justify-center">
                          <svg class="w-6 h-6 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                          </svg>
                        </div>
                        <div>
                          <div class="text-sm font-semibold text-navy">EasyTransac</div>
                          <div class="text-xs text-slate">Card, Apple Pay, Google Pay</div>
                        </div>
                      </div>
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-slate">EUR pricing</span>
                        <span class="text-xs font-medium text-navy">€{selectedPlan.easytransacAmount}</span>
                      </div>
                    </div>
                  </label>
                </div>
              </div>

              <div id="checkout-summary" class="hidden bg-slate-50 rounded-xl p-5 border border-slate-200">
                <div class="flex items-center justify-between mb-3">
                  <div>
                    <div class="text-sm font-semibold text-navy">Order Summary</div>
                    <div class="text-xs text-slate mt-1" id="summary-gateway"></div>
                  </div>
                  <div class="text-right">
                    <div class="text-lg font-bold text-navy" id="summary-price"></div>
                    <div class="text-xs text-slate" id="summary-currency"></div>
                  </div>
                </div>
                <div class="text-xs text-slate pt-3 border-t border-slate-200" id="summary-plan"></div>
              </div>

              <button
                type="submit"
                class="w-full bg-navy text-white px-6 py-4 rounded-lg font-semibold hover:bg-navy-light transition-colors flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                Proceed to Secure Checkout
              </button>
            </form>

            <div class="mt-6 pt-6 border-t border-slate-200">
              <div class="flex items-center justify-center gap-6 text-xs text-slate">
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                  <span>SSL Encrypted</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span>AES-256</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                  <span>Dodo Payments</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    const form = document.getElementById('checkout-form');
    const summary = document.getElementById('checkout-summary');
    const summaryGateway = document.getElementById('summary-gateway');
    const summaryPrice = document.getElementById('summary-price');
    const summaryCurrency = document.getElementById('summary-currency');
    const summaryPlan = document.getElementById('summary-plan');
    const gatewayInputs = form?.querySelectorAll('input[name="gateway"]');

    gatewayInputs?.forEach((input) => {
      input.addEventListener('change', function() {
        if (!summary || !summaryGateway || !summaryPrice || !summaryCurrency || !summaryPlan) return;
        const gateway = input.value;
        const planId = form?.getAttribute('data-plan');
        const planConfig = {
          developer: { name: 'Developer', price: 49, molliePrice: '49.00', paynowPrice: '49.00', easytransacPrice: '49.00', specs: ['4 GB RAM', '32 GB Storage', '1 Instance'] },
          professional: { name: 'Professional', price: 149, molliePrice: '149.00', paynowPrice: '149.00', easytransacPrice: '149.00', specs: ['8 GB RAM', '64 GB Storage', '4 Instances'] },
          team: { name: 'Team', price: 399, molliePrice: '399.00', paynowPrice: '399.00', easytransacPrice: '399.00', specs: ['16 GB RAM', '128 GB Storage', '12 Instances'] },
        };
        const selectedPlan = planId ? planConfig[planId] : null;
        if (selectedPlan) {
          summary.classList.remove('hidden');
          if (gateway === 'mollie') {
            summaryGateway.textContent = 'Mollie';
            summaryPrice.textContent = '€' + selectedPlan.molliePrice;
            summaryCurrency.textContent = 'EUR';
          } else if (gateway === 'paynow') {
            summaryGateway.textContent = 'PayNow';
            summaryPrice.textContent = '$' + selectedPlan.paynowPrice;
            summaryCurrency.textContent = 'USD';
          } else if (gateway === 'easytransac') {
            summaryGateway.textContent = 'EasyTransac';
            summaryPrice.textContent = '€' + selectedPlan.easytransacPrice;
            summaryCurrency.textContent = 'EUR';
          } else {
            summaryGateway.textContent = 'Dodo Payments';
            summaryPrice.textContent = '$' + selectedPlan.price;
            summaryCurrency.textContent = 'USD';
          }
          summaryPlan.textContent = selectedPlan.name + ' Plan · ' + selectedPlan.specs.join(', ');
        }
      });
    });

    form?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const email = form.email.value;
      const gateway = form.gateway ? form.gateway.value : '';
      const button = form?.querySelector('button[type="submit"]');
      if (!gateway) {
        alert('Please select a payment method before continuing.');
        return;
      }
      if (button) {
        button.disabled = true;
        button.innerHTML = '<span class="inline-flex items-center gap-2"><svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Processing...</span>';
      }
      try {
        const form = document.getElementById('checkout-form');
        const planId = form?.getAttribute('data-plan');
        const response = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ planId: planId || '', customerEmail: email, gateway }),
        });
        const data = await response.json();
        if (data.checkout_url) {
          window.location.href = data.checkout_url;
        } else {
          alert(data.error || 'Failed to initiate checkout. Please try again.');
          if (button) {
            button.disabled = false;
            button.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>Proceed to Secure Checkout';
          }
        }
      } catch {
        alert('An error occurred. Please try again.');
        if (button) {
          button.disabled = false;
          button.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>Proceed to Secure Checkout';
        }
      }
    });
  </script>
</Layout>
