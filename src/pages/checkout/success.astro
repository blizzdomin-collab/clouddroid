---
import Layout from '../../layouts/Layout.astro';
import { getCheckoutSessionBySessionId, completeCheckout, getUserByEmail } from '../../lib/database';

export const prerender = false;

const sessionId = Astro.url.searchParams.get('session_id');
let userCreated = false;
let userEmail = '';
let tempPassword = '';
let planName = '';
let errorMessage = '';
let paymentSuccess = false;
let gateway: 'dodo' | 'mollie' = 'dodo';

if (sessionId) {
  const checkoutSession = getCheckoutSessionBySessionId(sessionId);
  if (checkoutSession) {
    gateway = checkoutSession.payment_gateway === 'mollie' ? 'mollie' : 'dodo';
  }

  if (checkoutSession && checkoutSession.status === 'pending') {
    try {
      let paymentStatus: string | null = null;
      let amount = 0;
      let currency = 'USD';
      let customerId: string | null = null;

      if (gateway === 'mollie') {
        const mollieApiKey = import.meta.env.MOLLIE_API_KEY;
        if (mollieApiKey) {
          const environment = import.meta.env.MOLLIE_ENVIRONMENT || 'live';
          const baseUrl = environment === 'test' ? 'https://api.mollie.nl' : 'https://api.mollie.com';
          const paymentRes = await fetch(`${baseUrl}/v2/payments/${sessionId}`, {
            headers: {
              'Authorization': `Bearer ${mollieApiKey}`,
              'Content-Type': 'application/json',
            },
          });

          if (paymentRes.ok) {
            const paymentData = await paymentRes.json();
            paymentStatus = paymentData.status;
            amount = parseFloat(paymentData.amount?.value || '0');
            currency = paymentData.amount?.currency || 'EUR';
            customerId = paymentData.customerId || null;
          }
        }
      } else {
        const dodoApiKey = import.meta.env.DODO_PAYMENTS_API_KEY;
        if (dodoApiKey) {
          const sessionRes = await fetch(`https://api.dodopayments.com/v1/checkout-sessions/${sessionId}`, {
            headers: {
              'Authorization': `Bearer ${dodoApiKey}`,
              'Content-Type': 'application/json',
            },
          });

          if (sessionRes.ok) {
            const sessionData = await sessionRes.json();
            paymentStatus = sessionData.payment_status || sessionData.status;
            amount = (sessionData.amount_total || 0) / 100;
            currency = 'USD';
            customerId = sessionData.customer?.id || null;
          }
        }
      }

      if (paymentStatus === 'paid' || paymentStatus === 'completed') {
        paymentSuccess = true;
        const customerEmail = checkoutSession.email;
        const plan = checkoutSession.plan;
        tempPassword = checkoutSession.temp_password || '';

        const result = completeCheckout({
          email: customerEmail,
          plan,
          amount,
          currency,
          gateway,
          tempPassword,
          customerId,
          checkoutSessionId: checkoutSession.id,
        });

        userCreated = result.created;
        userEmail = customerEmail;
        planName = plan;
      }
    } catch (e) {
      errorMessage = 'Unable to verify payment status. Please contact support.';
    }
  } else if (checkoutSession && checkoutSession.status === 'completed') {
    userEmail = checkoutSession.email;
    planName = checkoutSession.plan;
    tempPassword = checkoutSession.temp_password || '';
    const user = getUserByEmail(userEmail);
    if (user) {
      userCreated = true;
      paymentSuccess = true;
    }
  }
}
---

<Layout title="Checkout Success - CloudDroid" description="Your CloudDroid subscription has been activated">
  <div class="min-h-screen bg-slate-light flex items-center justify-center py-16">
    <div class="max-w-md mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8">
        {paymentSuccess && userCreated ? (
          <>
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h1 class="text-2xl font-bold text-navy mb-4">Welcome to CloudDroid!</h1>
            <p class="text-slate mb-6">
              Your <span class="font-semibold text-navy">{planName}</span> subscription is now active. Your dashboard account has been created and your cloud Android workspaces are being provisioned.
            </p>
            <div class="bg-slate-50 rounded-lg p-4 mb-6 text-left">
              <p class="text-sm font-medium text-navy mb-2">Your login credentials:</p>
              <p class="text-sm text-slate mb-1"><span class="font-medium">Email:</span> {userEmail}</p>
              {tempPassword && (
                <p class="text-sm text-slate mb-1">
                  <span class="font-medium">Temporary password:</span>{' '}
                  <code class="bg-white px-2 py-1 rounded border border-slate-200">{tempPassword}</code>
                </p>
              )}
              <p class="text-xs text-slate mt-2">Please save this password and change it after logging in.</p>
            </div>
            <a
              href="/login"
              class="inline-flex items-center justify-center bg-navy text-white px-6 py-3 rounded-lg font-semibold hover:bg-navy-light transition-colors"
            >
              Go to Dashboard
            </a>
          </>
        ) : paymentSuccess && userEmail ? (
          <>
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h1 class="text-2xl font-bold text-navy mb-4">Subscription Active</h1>
            <p class="text-slate mb-6">
              Your <span class="font-semibold text-navy">{planName}</span> subscription is now active. You can log in with your existing account.
            </p>
            <div class="bg-slate-50 rounded-lg p-4 mb-6 text-left">
              <p class="text-sm font-medium text-navy mb-2">Your account:</p>
              <p class="text-sm text-slate mb-1"><span class="font-medium">Email:</span> {userEmail}</p>
              {tempPassword && (
                <p class="text-sm text-slate mb-1">
                  <span class="font-medium">Temporary password:</span>{' '}
                  <code class="bg-white px-2 py-1 rounded border border-slate-200">{tempPassword}</code>
                </p>
              )}
              <p class="text-xs text-slate mt-2">Please save this password and change it after logging in.</p>
            </div>
            <a
              href="/login"
              class="inline-flex items-center justify-center bg-navy text-white px-6 py-3 rounded-lg font-semibold hover:bg-navy-light transition-colors"
            >
              Go to Dashboard
            </a>
          </>
        ) : (
          <>
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h1 class="text-2xl font-bold text-navy mb-4">Payment Processing</h1>
            <p class="text-slate mb-6">
              Your payment is being processed. This page will update automatically once the payment is confirmed.
            </p>
            {errorMessage && <p class="text-sm text-red-600 mb-4">{errorMessage}</p>}
            <p class="text-sm text-slate mb-8">
              Securely processed by {gateway === 'mollie' ? 'Mollie' : 'Dodo Payments'}.
            </p>
            <a
              href="/"
              class="inline-flex items-center justify-center bg-navy text-white px-6 py-3 rounded-lg font-semibold hover:bg-navy-light transition-colors"
            >
              Return to Home
            </a>
          </>
        )}
      </div>
    </div>
  </div>
</Layout>
